  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch051", "global_index": 51, "label_ko": "8편 6장", "quote": "One of them was already a widow and lived in the inn with her two children, his grandchildren, and worked for him like a charwoman.", "disputed": false, "n_passes": 1}]</data>
