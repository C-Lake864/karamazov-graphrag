<edge source="Father Zossima" target="Ikon of the Saviour" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">42</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "In his hands was put an ikon of the Saviour.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Zossima" target="Nastasya" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">8</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch008", "global_index": 8, "label_ko": "2편 3장", "quote": "Go to your husband, mother; go this very day.” “I will go, Father, at your word. I will go.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Zossima" target="Father Anfim" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">39</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch039", "global_index": 39, "label_ko": "6편 1장", "quote": "Father Zossima had a great affection for this timorous man, and always treated him with marked respect", "disputed": false, "n_passes": 1}]</data>
</edge>
