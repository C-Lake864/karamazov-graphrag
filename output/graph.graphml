  <data key="d6">BROTHER_OF</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "He had spoken of it to the prisoner and his brother, Ivan Fyodorovitch, before the catastrophe.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Karamazov" target="Grushenka" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "If I repay Katerina Ivanovna, where can I find the means to go off with Grushenka?", "disputed": false, "n_passes": 1}]</data>
