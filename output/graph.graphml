  <data key="d6">PRESENT_AT</data>
  <data key="d7">82</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch082", "global_index": 82, "label_ko": "12편 3장", "quote": "Fetyukovitch positively started, as though scenting something, and caught at it instantly.", "disputed": false, "n_passes": 1}, {"doc_id": "ch093", "global_index": 93, "label_ko": "12편 14장", "quote": "Fetyukovitch concluded his speech with a bow, amid a hum of approbation in the court.", "disputed": false, "n_passes": 1}]</data>
</edge>
