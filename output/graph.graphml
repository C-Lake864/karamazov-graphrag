  <data key="d9">[{"doc_id": "ch036", "global_index": 36, "label_ko": "5편 5장", "quote": "The guards lead their prisoner to the close, gloomy vaulted prison in the ancient palace of the Holy Inquisition and shut Him in it.", "disputed": false, "n_passes": 1}]</data>
