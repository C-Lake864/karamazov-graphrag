  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch036", "global_index": 36, "label_ko": "5편 5장", "quote": "He is not dressed in his gorgeous cardinal’s robes, as he was the day before, when he was burning the enemies of the Roman Church", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Grand Inquisitor" target="Seville" id="LIVES_AT">
