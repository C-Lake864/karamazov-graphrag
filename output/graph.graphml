  <data key="d6">LIVES_AT</data>
  <data key="d7">89</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch089", "global_index": 89, "label_ko": "12편 10장", "quote": "although he practiced in Petersburg, he had more than once visited provincial towns to defend prisoners, of whose innocence he had a conviction or at least a preconceived idea.", "disputed": false, "n_passes": 2}, {"doc_id": "ch092", "global_index": 92, "label_ko": "12편 13장", "quote": "I will not yield the defense of the prisoner to the lawyer who has come down from Petersburg.", "disputed": false, "n_passes": 2}]</data>
</edge>
