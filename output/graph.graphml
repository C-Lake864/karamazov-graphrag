  <data key="d6">PRESENT_AT</data>
  <data key="d7">83</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "“When the prisoner was arrested at Mokroe,” the prosecutor asked, “every one saw and heard you run out of the next room and cry out: ‘It’s all my fault.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="The trial" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">93</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch093", "global_index": 93, "label_ko": "12편 14장", "quote": "From the farthest corner at the back of the gallery came a piercing shriek—it was Grushenka. She had succeeded in begging admittance to the court again", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="house of the widow Morozov" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "Grushenka lived in the busiest part of the town, near the cathedral square, in a small wooden lodge in the courtyard belonging to the house of the widow Morozov.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Grushenka" target="Mihail Osipovitch" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "Hush, evil tongue!” Grushenka cried angrily at him; “you never said such words to me as he has come to say.”", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="Plastunov's Inn" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">51</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch051", "global_index": 51, "label_ko": "8편 6장", "quote": "“Agrafena Alexandrovna?” The inn-keeper understood at once, looking sharply into Mitya’s face. “She’s here, too ...”", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Rakitin" target="Katerina Ivanovna" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">12</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch012", "global_index": 12, "label_ko": "2편 7장", "quote": "I guess from your warmth that you are not indifferent to Katerina Ivanovna yourself; I’ve suspected that for a long time, brother", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="Ivan Fyodorovitch Karamazov" id="RIVAL_OF">
  <data key="d6">RIVAL_OF</data>
  <data key="d7">12</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch012", "global_index": 12, "label_ko": "2편 7장", "quote": "that’s why you don’t like my brother Ivan. Are you jealous of him?", "disputed": true, "n_passes": 2}]</data>
</edge>
<edge source="Rakitin" target="Ivan Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">12</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch012", "global_index": 12, "label_ko": "2편 7장", "quote": "Don’t you understand that one might very well dislike him, apart from Katerina Ivanovna. And why the devil should I like him? He condescends to abuse me, you know.", "disputed": false, "n_passes": 1}, {"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "He can’t bear Ivan, he hates him. He’s not fond of you, either.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="Grushenka" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">12</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch012", "global_index": 12, "label_ko": "2편 7장", "quote": "Oh, yes, I’d forgotten she was a relation of yours.” “A relation! That Grushenka a relation of mine!”", "disputed": true, "n_passes": 2}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "Why, he is my cousin. His mother was my mother’s sister. But he’s always besought me not to tell any one here of it, he is so dreadfully ashamed of me.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="Grushenka" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">81</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch081", "global_index": 81, "label_ko": "12편 2장", "quote": "Then you did take— But you have not given it back yet ... or have you?” “That’s of no consequence,” muttered Rakitin, “I refuse to answer such questions.... Of course I shall give it back.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Rakitin" target="Grushenka" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "Look, Alyosha, he’s sitting there opposite us, so offended that I didn’t ask him to sit down before you. Ugh, Rakitin is such a one to take offense!” laughed Grushenka.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Rakitin" target="Sausage" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">43</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch043", "global_index": 43, "label_ko": "7편 2장", "quote": "I’ve got some sausage in my pocket; I’ve brought it from the town in case of need, only you won’t eat sausage....", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Rakitin" target="Alexey Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">43</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch043", "global_index": 43, "label_ko": "7편 2장", "quote": "first a revengeful desire to see “the downfall of the righteous,” and Alyosha’s fall “from the saints to the sinners,” over which he was already gloating in his imagination", "disputed": false, "n_passes": 3}, {"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "don’t taunt me with having rebelled against God.", "disputed": false, "n_passes": 5}, {"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "Rakitin did not like meeting Alyosha, especially of late. He scarcely spoke to him, and bowed to him stiffly.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Rakitin" target="Pyotr Ilyitch Perhotin" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">50</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch050", "global_index": 50, "label_ko": "8편 5장", "quote": "Perhotin’s servant-boy, who met Mitya in the passage, said afterwards that he walked into the passage in the same way", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="Pyotr Ilyitch Perhotin" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">71</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "He had met Pyotr Ilyitch here before, and would you believe it, he is always gibing at him, growling at him, for some reason.", "disputed": false, "n_passes": 6}]</data>
</edge>
<edge source="Rakitin" target="Kolya Krassotkin" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">68</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch068", "global_index": 68, "label_ko": "10편 6장", "quote": "Ah, I know where you read that, and I am sure some one told you so!” cried Alyosha. “I say, what makes you think I read it?", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Rakitin" target="Madame Hohlakov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">71</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "that frivolous young man, would you believe it, seems to have taken it into his head to fall in love with me.", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="Madame Hohlakov" id="ENGAGED_TO">
  <data key="d6">ENGAGED_TO</data>
  <data key="d7">73</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "And he told me he was courting Madame Hohlakov. She hadn’t much brains in her youth, and now at forty she has lost what she had.", "disputed": true, "n_passes": 2}]</data>
</edge>
<edge source="Rakitin" target="Dmitri Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">73</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "Rakitin fired up instantly. “You’d better give that advice to your own family, who’ve always been a slave-driving lot, and not to Rakitin,” he cried", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="Dmitri Fyodorovitch Karamazov" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">81</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch081", "global_index": 81, "label_ko": "12편 2장", "quote": "When, after Rakitin’s cross-examination, the President asked the prisoner if he had anything to say, Mitya cried loudly: “Since I’ve been arrested, he has borrowed money from me!", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Rakitin" target="the Monastery" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">7</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch007", "global_index": 7, "label_ko": "2편 2장", "quote": "He was a divinity student, living under the protection of the monastery.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Maximov" target="Dmitri Fyodorovitch Karamazov" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">61</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch061", "global_index": 61, "label_ko": "9편 8장", "quote": "The old man at once confessed that he had done wrong, that he had borrowed “ten roubles in my poverty,” from Dmitri Fyodorovitch, and that he was ready to pay it back.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Maximov" target="widow Morozov's house" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">70</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "When the homeless old man returned with Grushenka from Mokroe two months before, he had simply stayed on and was still staying with her.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Marfa Ignatyevna" target="The lodge" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">14</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch014", "global_index": 14, "label_ko": "3편 1장", "quote": "And in the lodge there were only three servants: old Grigory, and his old wife Marfa, and a young man called Smerdyakov.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Marfa Ignatyevna" target="Fyodor Pavlovitch Karamazov" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">14</data>
  <data key="d8">5</data>
  <data key="d9">[{"doc_id": "ch014", "global_index": 14, "label_ko": "3편 1장", "quote": "She was set on leaving Fyodor Pavlovitch and opening a little shop in Moscow with their small savings.", "disputed": false, "n_passes": 3}, {"doc_id": "ch016", "global_index": 16, "label_ko": "3편 3장", "quote": "they went every day to Fyodor Pavlovitch’s kitchen for soup and bread, which Marfa gave readily.", "disputed": false, "n_passes": 1}, {"doc_id": "ch038", "global_index": 38, "label_ko": "5편 7장", "quote": "It was about nine o’clock when Marfa Ignatyevna came in with her usual inquiry, “Where will your honor take your tea, in your own room or downstairs?”", "disputed": false, "n_passes": 4}, {"doc_id": "ch055", "global_index": 55, "label_ko": "9편 2장", "quote": "seeing that her master’s window was open and that there was a candle alight in the window, she ran there and began calling Fyodor Pavlovitch.", "disputed": false, "n_passes": 3}, {"doc_id": "ch087", "global_index": 87, "label_ko": "12편 8장", "quote": "the third person was Grigory’s wife, Marfa Ignatyevna, but it would be simply shameful to imagine her murdering her master.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Marfa Ignatyevna" target="Grigory" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">14</data>
  <data key="d8">5</data>
  <data key="d9">[{"doc_id": "ch014", "global_index": 14, "label_ko": "3편 1장", "quote": "It happened that, on the very night after the burial of his child, Marfa was awakened by the wail of a new-born baby. She was frightened and waked her husband.", "disputed": false, "n_passes": 2}, {"doc_id": "ch049", "global_index": 49, "label_ko": "8편 4장", "quote": "while his wife repeated a “certain prayer” over him, after which he had gone to bed. Marfa Ignatyevna had tasted the stuff, too", "disputed": false, "n_passes": 1}, {"doc_id": "ch055", "global_index": 55, "label_ko": "9편 2장", "quote": "Marfa Ignatyevna, the wife of old Grigory, who had been knocked senseless near the fence, was sleeping soundly in her bed and might well have slept till morning", "disputed": false, "n_passes": 1}, {"doc_id": "ch075", "global_index": 75, "label_ko": "11편 6장", "quote": "Grigory’s wife, Marfa, in answer to Ivan’s questions, declared that Smerdyakov had been lying all night the other side of the partition wall.", "disputed": false, "n_passes": 2}, {"doc_id": "ch087", "global_index": 87, "label_ko": "12편 8장", "quote": "the third person was Grigory’s wife, Marfa Ignatyevna,", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Marfa Ignatyevna" target="Smerdyakov" id="RAISED">
  <data key="d6">RAISED</data>
  <data key="d7">15</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch015", "global_index": 15, "label_ko": "3편 2장", "quote": "So Marfa brought up the child. He was christened Pavel, to which people were not slow in adding Fyodorovitch (son of Fyodor).", "disputed": false, "n_passes": 3}, {"doc_id": "ch019", "global_index": 19, "label_ko": "3편 6장", "quote": "He was brought up by Grigory and Marfa, but the boy grew up “with no sense of gratitude,”", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Marfa Ignatyevna" target="murder of Fyodor Pavlovitch" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">55</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch055", "global_index": 55, "label_ko": "9편 2장", "quote": "Terror-stricken, Marfa rushed away from the window, ran out of the garden, drew the bolt of the big gate and ran headlong by the back way to the neighbor, Marya Kondratyevna.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Ilya" target="Lizaveta Smerdyastchaya" id="FATHER_OF">
  <data key="d6">FATHER_OF</data>
  <data key="d7">15</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch015", "global_index": 15, "label_ko": "3편 2장", "quote": "Her father, a homeless, sickly drunkard, called Ilya, had lost everything and lived many years as a workman with some well-to-do tradespeople.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Ilya" target="Lizaveta Smerdyastchaya" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">15</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch015", "global_index": 15, "label_ko": "3편 2장", "quote": "Spiteful and diseased, Ilya used to beat Lizaveta inhumanly whenever she returned to him.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Lizaveta Smerdyastchaya" target="Birth of Lizaveta's child" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">14</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch014", "global_index": 14, "label_ko": "3편 1장", "quote": "known to the whole town by the nickname of Lizaveta Smerdyastchaya (Stinking Lizaveta), had got into the bath-house and had just given birth to a child.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Lizaveta Smerdyastchaya" target="Vishegorye" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
