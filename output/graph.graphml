  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch025", "global_index": 25, "label_ko": "4편 1장", "quote": "I have been at your Sylvester’s. I used to stay there.", "disputed": false, "n_passes": 1}]</data>
</edge>
