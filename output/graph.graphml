  <data key="d9">[{"doc_id": "ch061", "global_index": 61, "label_ko": "9편 8장", "quote": "was the sum spent here, at Mokroe, by Mitya on the first occasion, a month before, three thousand or fifteen hundred?", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="carousal at Mokroe" target="Mokroe" id="OCCURRED_AT">
  <data key="d6">OCCURRED_AT</data>
  <data key="d7">61</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch061", "global_index": 61, "label_ko": "9편 8장", "quote": "three thousand roubles had certainly been spent on the first carousal at Mokroe", "disputed": false, "n_passes": 1}, {"doc_id": "ch081", "global_index": 81, "label_ko": "12편 2장", "quote": "asking him about an incident at the first carousal at Mokroe, a month before the arrest", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Mavriky Mavrikyevitch Schmertsov" target="Dmitri Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">62</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch062", "global_index": 62, "label_ko": "9편 9장", "quote": "I’m not ‘old fellow’ to you, and you can keep your advice for another time!” Mavriky Mavrikyevitch snapped out savagely", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Anna Fyodorovna Krassotkin" target="Kolya Krassotkin" id="RAISED">
  <data key="d6">RAISED</data>
  <data key="d7">63</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "From the day of his death she had devoted herself heart and soul to the bringing up of her precious treasure, her boy Kolya.", "disputed": false, "n_passes": 3}, {"doc_id": "ch064", "global_index": 64, "label_ko": "10편 2장", "quote": "regardless of his mother’s constantly reiterated entreaties that he would always put on goloshes in such cold weather", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Anna Fyodorovna Krassotkin" target="Kolya Krassotkin" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">63</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "Though she had loved him passionately those fourteen years, he had caused her far more suffering than happiness.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Dardanelov" target="Anna Fyodorovna Krassotkin" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">63</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "Dardanelov was a middle-aged bachelor, who had been passionately in love with Madame Krassotkin for many years past", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Dardanelov" target="Kolya Krassotkin" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">63</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "He was fond of the boy, though he would have felt it beneath him to try and win him over, and was severe and strict with him in class.", "disputed": false, "n_passes": 3}, {"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "I say nothing against Dardanelov, he is a learned man, there’s no doubt about it. I respect men like that and it’s not because he stood up for me.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Kostya" target="Nastya" id="BROTHER_OF">
  <data key="d6">BROTHER_OF</data>
  <data key="d7">64</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch064", "global_index": 64, "label_ko": "10편 2장", "quote": "Nastya, the elder, a girl of eight, could read, and Kostya, the boy, aged seven, was very fond of being read to by her.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Kostya" target="Nastya" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">64</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch064", "global_index": 64, "label_ko": "10편 2장", "quote": "They were both sitting as before at the table, not reading but warmly disputing about something.", "disputed": false, "n_passes": 1}]</data>
</edge>
