  <data key="d9">[{"doc_id": "ch082", "global_index": 82, "label_ko": "12편 3장", "quote": "Doctor Herzenstube, when called as a witness, was quite unexpectedly of use to Mitya.", "disputed": false, "n_passes": 1}]</data>
