  <data key="d9">[{"doc_id": "ch006", "global_index": 6, "label_ko": "2편 1장", "quote": "drove up with Miüsov and a distant relative of his, a young man of twenty, called Pyotr Fomitch Kalganov.", "disputed": false, "n_passes": 1}, {"doc_id": "ch051", "global_index": 51, "label_ko": "8편 6장", "quote": "One’s quite a young gentleman, a relative of Mr. Miüsov, he must be, but I’ve forgotten his name", "disputed": true, "n_passes": 3}]</data>
</edge>
