<edge source="Smurov" target="Wisp of Tow" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">27</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch027", "global_index": 27, "label_ko": "4편 3장", "quote": "“Give it him, hit him back, Smurov,” they all shouted. But Smurov, the left-handed boy, needed no telling, and at once revenged himself;", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Yulia" target="Madame Hohlakov" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">28</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch028", "global_index": 28, "label_ko": "4편 4장", "quote": "Mamma, for goodness’ sake go yourself and hurry Yulia, she is such a slowcoach and never can come quickly!", "disputed": false, "n_passes": 2}, {"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "Run and say, Yulia, that I’ll fly to her.", "disputed": false, "n_passes": 3}, {"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "flew into a passion with Yulia and, would you believe it, slapped her in the face. That’s monstrous; I am always polite to my servants.", "disputed": false, "n_passes": 7}]</data>
</edge>
<edge source="Madame Hohlakov" target="Madame Hohlakov's house" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">28</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch028", "global_index": 28, "label_ko": "4편 4장", "quote": "yet she had a house in our town too, inherited from her forefathers.", "disputed": false, "n_passes": 2}, {"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "burst out crying like a little child a few steps from the Hohlakovs’ house.", "disputed": false, "n_passes": 1}, {"doc_id": "ch054", "global_index": 54, "label_ko": "9편 1장", "quote": "It was exactly eleven o’clock when he entered Madame Hohlakov’s house.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Madame Hohlakov" target="Katerina Ivanovna" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">29</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "Oh, how I love her, especially sometimes, and how glad I am again of everything!", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Madame Hohlakov" target="Lise" id="FATHER_OF">
  <data key="d6">FATHER_OF</data>
  <data key="d7">29</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "“Mamma, you are spoiling him,” Lise’s little voice cried from behind the door.", "disputed": false, "n_passes": 1}, {"doc_id": "ch032", "global_index": 32, "label_ko": "5편 1장", "quote": "“_Merci, maman._ Come in, Alexey Fyodorovitch.” Alyosha went in.", "disputed": false, "n_passes": 1}, {"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "come back and tell me—me, her mother, for you understand it will be the death of me", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Madame Hohlakov" target="Dmitri Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "She had detested him from the first because he was engaged to Katerina Ivanovna", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Madame Hohlakov" target="Madame Belmesov" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "You have most likely heard of my cousin, Madame Belmesov. Her husband was ruined, ‘had come to grief,’ as you characteristically express it, Dmitri Fyodorovitch.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Madame Hohlakov" target="Pyotr Alexandrovitch Miüsov" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "I’m quarreling with my steward about it, and I’ve just borrowed five hundred roubles from Miüsov, myself. No, no, I’ve no money.", "disputed": false, "n_passes": 6}]</data>
</edge>
<edge source="Madame Hohlakov" target="Madame Hohlakov's carriage" id="POSSESSES">
  <data key="d6">POSSESSES</data>
