  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch027", "global_index": 27, "label_ko": "4편 3장", "quote": "“Give it him, hit him back, Smurov,” they all shouted. But Smurov, the left-handed boy, needed no telling, and at once revenged himself;", "disputed": false, "n_passes": 1}]</data>
