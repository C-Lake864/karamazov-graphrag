<edge source="Father Ferapont" target="Father Zossima" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">25</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch025", "global_index": 25, "label_ko": "4편 1장", "quote": "This Father Ferapont was that aged monk so devout in fasting and observing silence who has been mentioned already, as antagonistic to Father Zossima", "disputed": false, "n_passes": 3}, {"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "As every one was aware, Father Ferapont particularly disliked Father Zossima.", "disputed": false, "n_passes": 5}]</data>
</edge>
<edge source="Father Ferapont" target="Father Païssy" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">42</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "“Go away, Father!” said Father Païssy, in a commanding voice, “it’s not for man to judge but for God.", "disputed": false, "n_passes": 4}]</data>
</edge>
<edge source="Father Ferapont" target="the Hermitage" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">25</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch025", "global_index": 25, "label_ko": "4편 1장", "quote": "Though he lived in the hermitage they did not worry him to keep its regulations, and this too because he behaved as though he were crazy.", "disputed": false, "n_passes": 1}]</data>
</edge>
