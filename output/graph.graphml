  <data key="d6">MENTOR_OF</data>
  <data key="d7">67</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "The classical master, Kolbasnikov, was particularly shocked about it, but Dardanelov got me off again.", "disputed": false, "n_passes": 5}]</data>
</edge>
