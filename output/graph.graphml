</edge>
<edge source="Captain Snegiryov" target="Ilusha's boots" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">96</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "fell on his knees, snatched up one boot and, pressing his lips to it, began kissing it greedily", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Captain Snegiryov" target="Arina Petrovna" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">30</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "But now let me present you to my wife, Arina Petrovna. She is crippled, she is forty-three", "disputed": false, "n_passes": 1}]</data>
</edge>
