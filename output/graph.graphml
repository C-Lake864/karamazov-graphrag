  <data key="d9">[{"doc_id": "ch025", "global_index": 25, "label_ko": "4편 1장", "quote": "an old woman from the town, a sergeant's widow, called Prohorovna. She had inquired whether she might pray for the rest of the soul of her son, Vassenka", "disputed": false, "n_passes": 1}]</data>
