  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch039", "global_index": 39, "label_ko": "6편 1장", "quote": "as that dear good woman from Vishegorye, with her little Lizaveta in her arms, wished me yesterday.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Agafya Ivanovna" target="Katerina Ivanovna" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">17</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch017", "global_index": 17, "label_ko": "3편 4장", "quote": "This second daughter is Katerina Ivanovna, and she was the child of the second wife", "disputed": false, "n_passes": 1}, {"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "One of them, a woman of little education, was that aunt of her half-sister Agafya Ivanovna who had looked after her in her father’s house when she came from boarding-school.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Agafya Ivanovna" target="Anna Fyodorovna Krassotkin" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">64</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch064", "global_index": 64, "label_ko": "10편 2장", "quote": "Agafya, Madame Krassotkin’s servant, a stout woman of forty, marked with small-pox, appeared in the doorway.", "disputed": false, "n_passes": 3}]</data>
</edge>
