<edge source="Varvara" target="Captain Snegiryov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">30</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "Do give over fooling, showing off your silly antics which never lead to anything!” shouted Varvara, stamping her foot with passion.", "disputed": false, "n_passes": 1}]</data>
