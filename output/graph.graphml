  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "The room inhabited by the family of the retired captain Snegiryov is already familiar to the reader.", "disputed": false, "n_passes": 1}]</data>
