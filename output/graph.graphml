  <data key="d9">[{"doc_id": "ch082", "global_index": 82, "label_ko": "12편 3장", "quote": "He was a conscientious doctor and an excellent and pious man, a Hernguter or Moravian brother, I am not quite sure which.", "disputed": true, "n_passes": 1}]</data>
