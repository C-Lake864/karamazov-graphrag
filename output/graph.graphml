<edge source="Diderot" target="Metropolitan Platon" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">7</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch007", "global_index": 7, "label_ko": "2편 2장", "quote": "They all believe to this day that the infidel Diderot came to dispute about God with the Metropolitan Platon....", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Nikita" target="Alexey Fyodorovitch Karamazov" id="FATHER_OF">
  <data key="d6">FATHER_OF</data>
  <data key="d7">8</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch008", "global_index": 8, "label_ko": "2편 3장", "quote": "We had four, my Nikita and I, and now we’ve no children, our dear ones have all gone.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Vasenka" target="Irkutsk" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">8</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch008", "global_index": 8, "label_ko": "2편 3장", "quote": "Her son Vasenka was in the commissariat service, and had gone to Irkutsk in Siberia.", "disputed": true, "n_passes": 6}]</data>
</edge>
<edge source="Vasenka" target="Siberia" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">8</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch008", "global_index": 8, "label_ko": "2편 3장", "quote": "Her son Vasenka was in the commissariat service, and had gone to Irkutsk in Siberia.", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Lise" target="Alexey Fyodorovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">9</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch009", "global_index": 9, "label_ko": "2편 4장", "quote": "Yet Lise has told me twice that she is never happy except with you.", "disputed": true, "n_passes": 3}, {"doc_id": "ch024", "global_index": 24, "label_ko": "3편 11장", "quote": "Dear Alyosha, I love you, I’ve loved you from my childhood, since our Moscow days, when you were very different from what you are now, and I shall love you all my life.", "disputed": false, "n_passes": 3}, {"doc_id": "ch032", "global_index": 32, "label_ko": "5편 1장", "quote": "“That makes it worse! Worse and better than all! Alyosha, I am awfully fond of you.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Lise" target="Alexey Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">9</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch009", "global_index": 9, "label_ko": "2편 4장", "quote": "Lise had in fact been occupied in mocking at him all the time.", "disputed": false, "n_passes": 3}, {"doc_id": "ch032", "global_index": 32, "label_ko": "5편 1장", "quote": "here I’ve brought you Alexey Fyodorovitch, whom you insulted so. He is not at all angry, I assure you", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Lise" target="Yulia" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">71</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "early this morning Lise waked up and flew into a passion with Yulia and, would you believe it, slapped her in the face.", "disputed": false, "n_passes": 5}]</data>
</edge>
<edge source="Lise" target="Ivan Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">71</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "She suddenly screamed out, ‘I hate Ivan Fyodorovitch. I insist on your never letting him come to the house again.’", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Lise" target="Madame Hohlakov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">71</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "she rushed to kiss me, crying, and as she kissed me, she pushed me out of the room without saying a word, so I couldn’t find out what was the matter.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Iosif" target="Pyotr Alexandrovitch Miüsov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">10</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch010", "global_index": 10, "label_ko": "2편 5장", "quote": "“Strange, extremely strange!” Miüsov pronounced, not so much with heat as with latent indignation. “What strikes you as so strange?” Father Iosif inquired cautiously.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Iosif" target="the Monastery" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">13</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch013", "global_index": 13, "label_ko": "2편 8장", "quote": "Father Iosif, Father Païssy, and one other monk were the only inmates of the monastery invited.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Païssy" target="Pyotr Alexandrovitch Miüsov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">10</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch010", "global_index": 10, "label_ko": "2편 5장", "quote": "“You are completely misunderstanding it,” said Father Païssy sternly.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Father Païssy" target="Alexey Fyodorovitch Karamazov" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">25</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch025", "global_index": 25, "label_ko": "4편 1장", "quote": "he suddenly realized that he had met a new and unexpected friend, a warmly loving teacher, in this austere monk who had hitherto treated him sternly.", "disputed": false, "n_passes": 6}, {"doc_id": "ch036", "global_index": 36, "label_ko": "5편 5장", "quote": "Is that Father Païssy’s teaching?” “No, no, on the contrary, Father Païssy did once say something rather the same as you", "disputed": false, "n_passes": 1}, {"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "cast a strange, very strange, look at the Father to whom his former guide, the former sovereign of his heart and mind, his beloved elder, had confided him as he lay dying.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Father Païssy" target="Father Ferapont" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">42</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "“What have you come for, worthy Father? Why do you offend against good order? Why do you disturb the peace of the flock?” he said at last, looking sternly at him.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Father Païssy" target="The Elder's Cell" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">45</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch045", "global_index": 45, "label_ko": "7편 4장", "quote": "There was no one in the cell but Father Païssy, reading the Gospel in solitude over the coffin, and the young novice Porfiry", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Païssy" target="Alexei Fyodorovitch Karamazov" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">36</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch036", "global_index": 36, "label_ko": "5편 5장", "quote": "“No, no, on the contrary, Father Païssy did once say something rather the same as you ... but of course it’s not the same, not a bit the same,” Alyosha hastily corrected himself.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Païssy" target="Gospel" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">42</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "Father Païssy, with a stern face, continued firmly and distinctly reading aloud the Gospel, apparently not noticing what was taking place around him", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Païssy" target="the Monastery" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">13</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch013", "global_index": 13, "label_ko": "2편 8장", "quote": "Father Iosif, Father Païssy, and one other monk were the only inmates of the monastery invited.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Païssy" target="Father Zossima" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">25</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch025", "global_index": 25, "label_ko": "4편 1장", "quote": "He always confessed to Father Païssy.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Father Païssy" target="the Hermitage" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">42</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch042", "global_index": 42, "label_ko": "7편 1장", "quote": "As he walked round the hermitage, Father Païssy remembered Alyosha", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Fyodor Pavlovitch Karamazov" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">11</data>
  <data key="d8">20</data>
  <data key="d9">[{"doc_id": "ch011", "global_index": 11, "label_ko": "2편 6장", "quote": "Smerdyakov, the valet sent me by my father, in reply to my inquiries, told me twice over that the appointment was for one.", "disputed": false, "n_passes": 3}, {"doc_id": "ch014", "global_index": 14, "label_ko": "3편 1장", "quote": "And in the lodge there were only three servants: old Grigory, and his old wife Marfa, and a young man called Smerdyakov.", "disputed": false, "n_passes": 2}, {"doc_id": "ch015", "global_index": 15, "label_ko": "3편 2장", "quote": "So this Smerdyakov became Fyodor Pavlovitch’s second servant, and was living in the lodge with Grigory and Marfa at the time our story begins.", "disputed": false, "n_passes": 3}, {"doc_id": "ch019", "global_index": 19, "label_ko": "3편 6장", "quote": "The servants, Grigory and Smerdyakov, were standing by.", "disputed": false, "n_passes": 3}, {"doc_id": "ch021", "global_index": 21, "label_ko": "3편 8장", "quote": "“Get along with you, Jesuits!” he cried to the servants. “Go away, Smerdyakov.", "disputed": false, "n_passes": 3}, {"doc_id": "ch022", "global_index": 22, "label_ko": "3편 9장", "quote": "They had been struggling with him in the passage, refusing to admit him, acting on instructions given them by Fyodor Pavlovitch some days before.", "disputed": false, "n_passes": 1}, {"doc_id": "ch026", "global_index": 26, "label_ko": "4편 2장", "quote": "He was quite alone in the house, for Smerdyakov too had gone out marketing.", "disputed": false, "n_passes": 1}, {"doc_id": "ch037", "global_index": 37, "label_ko": "5편 6장", "quote": "But Grigory Vassilyevitch does not come, because I wait upon him alone in his room now.", "disputed": false, "n_passes": 4}, {"doc_id": "ch038", "global_index": 38, "label_ko": "5편 7장", "quote": "“What’s the matter with him?” he promptly asked Smerdyakov, who had followed Ivan. “Angry about something. Who can tell?” the valet muttered evasively.", "disputed": false, "n_passes": 3}, {"doc_id": "ch055", "global_index": 55, "label_ko": "9편 2장", "quote": "The doctor remained at Fyodor Pavlovitch’s to make a post-mortem next day on the body. But he was particularly interested in the condition of the servant, Smerdyakov.", "disputed": false, "n_passes": 3}, {"doc_id": "ch058", "global_index": 58, "label_ko": "9편 5장", "quote": "So no one knew of the signals but your dead father, you, and the valet Smerdyakov?", "disputed": false, "n_passes": 3}, {"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I went to the window and shouted to the master, ‘It’s I.’", "disputed": false, "n_passes": 3}, {"doc_id": "ch079", "global_index": 79, "label_ko": "11편 10장", "quote": "to confess you murdered your father, that the valet murdered him at your instigation.", "disputed": false, "n_passes": 1}, {"doc_id": "ch081", "global_index": 81, "label_ko": "12편 2장", "quote": "and related how Smerdyakov had once found the master’s money in the yard, and, instead of concealing it, had taken it to his master", "disputed": false, "n_passes": 3}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "The lackey, Smerdyakov, who murdered his master and hanged himself last night.", "disputed": false, "n_passes": 2}, {"doc_id": "ch085", "global_index": 85, "label_ko": "12편 6장", "quote": "formerly the servant, and possibly the illegitimate son, of Fyodor Pavlovitch, Smerdyakov.", "disputed": false, "n_passes": 3}, {"doc_id": "ch086", "global_index": 86, "label_ko": "12편 7장", "quote": "and there learns that Smerdyakov is in a fit, that the other servant is ill—the coast is clear and he knows the ‘signals’", "disputed": false, "n_passes": 2}, {"doc_id": "ch087", "global_index": 87, "label_ko": "12편 8장", "quote": "He was naturally very honest and enjoyed the complete confidence of his master", "disputed": false, "n_passes": 5}, {"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "What if his master had taken the notes from under his bed and put them back in his cash-box without telling him?", "disputed": true, "n_passes": 3}, {"doc_id": "ch091", "global_index": 91, "label_ko": "12편 12장", "quote": "compared with that of his master’s legitimate sons. They had everything, he nothing. They had all the rights, they had the inheritance, while he was only the cook.", "disputed": false, "n_passes": 6}]</data>
</edge>
<edge source="Smerdyakov" target="Fyodor Pavlovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">87</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch087", "global_index": 87, "label_ko": "12편 8장", "quote": "deceived his master, whom he loved as his benefactor.", "disputed": true, "n_passes": 2}]</data>
</edge>
<edge source="Smerdyakov" target="Fyodor Pavlovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I snatched up that iron paper-weight from his table; do you remember, weighing about three pounds? I swung it and hit him on the top of the skull with the corner of it.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="The lodge" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">14</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch014", "global_index": 14, "label_ko": "3편 1장", "quote": "And in the lodge there were only three servants: old Grigory, and his old wife Marfa, and a young man called Smerdyakov.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Smerdyakov" target="Dmitri Fyodorovitch Karamazov" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">37</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch037", "global_index": 37, "label_ko": "5편 6장", "quote": "he pitched on me to be his servant.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="murder of Fyodor Pavlovitch" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">58</data>
  <data key="d8">7</data>
  <data key="d9">[{"doc_id": "ch058", "global_index": 58, "label_ko": "9편 5장", "quote": "“And you don’t even suspect him?” “Why, do you suspect him?” “He is suspected, too.”", "disputed": true, "n_passes": 1}, {"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "It was you, you who persuaded me that he murdered his father. It’s only you I believed!", "disputed": true, "n_passes": 3}, {"doc_id": "ch075", "global_index": 75, "label_ko": "11편 6장", "quote": "My brother directly accuses you of the murder and theft.", "disputed": true, "n_passes": 3}, {"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "if I don’t beat you to death, it’s simply because I suspect you of that crime and I’ll drag you to justice.", "disputed": true, "n_passes": 2}, {"doc_id": "ch086", "global_index": 86, "label_ko": "12편 7장", "quote": "At this point Ippolit Kirillovitch broke off to discuss exhaustively the suspected connection of Smerdyakov with the murder.", "disputed": true, "n_passes": 3}, {"doc_id": "ch087", "global_index": 87, "label_ko": "12편 8장", "quote": "The first person who cried out that Smerdyakov had committed the murder was the prisoner himself at the moment of his arrest", "disputed": true, "n_passes": 5}, {"doc_id": "ch091", "global_index": 91, "label_ko": "12편 12장", "quote": "has to-day produced a bundle of notes and proclaimed Smerdyakov as the murderer.", "disputed": true, "n_passes": 5}]</data>
</edge>
<edge source="Smerdyakov" target="murder of Fyodor Pavlovitch" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I swung it and hit him on the top of the skull with the corner of it. He didn’t even cry out.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Smerdyakov" target="Hospital" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">75</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch075", "global_index": 75, "label_ko": "11편 6장", "quote": "He put that off till he had seen Smerdyakov, who was at that time in the hospital.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Marya Kondratyevna" id="ENGAGED_TO">
  <data key="d6">ENGAGED_TO</data>
  <data key="d7">76</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "It was supposed afterwards that he had come to stay with them as Marya Kondratyevna’s betrothed, and was living there for a time without paying for board or lodging.", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Smerdyakov" target="Grigory" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">20</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch020", "global_index": 20, "label_ko": "3편 7장", "quote": "You’re anathema accursed, as it is,” Grigory suddenly burst out, “and how dare you argue, you rascal, after that, if—”", "disputed": false, "n_passes": 1}, {"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "in the same complacent and sententious tone in which he had taunted Grigory and argued with him about religion at Fyodor Pavlovitch’s table", "disputed": false, "n_passes": 3}, {"doc_id": "ch091", "global_index": 91, "label_ko": "12편 12장", "quote": "He was disrespectful to the servant Grigory and his wife, who had cared for him in his childhood.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Ivan Fyodorovitch Karamazov" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "The startling, incredibly supercilious tone of this man who had once been his valet, was extraordinary in itself.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Smerdyakov" target="Ivan Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">38</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch038", "global_index": 38, "label_ko": "5편 7장", "quote": "except perhaps that he loathed the valet as one who had insulted him more gravely than any one in the world.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="The Sayings of the Holy Father Isaac the Syrian" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "took up the big yellow book that Ivan had noticed at first lying on the table, and put it over the notes. The book was _The Sayings of the Holy Father Isaac the Syrian_.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Smerdyakov" target="Three thousand roubles" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">77</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I wiped the paper-weight, put it back, went up to the ikons, took the money out of the envelope, and flung the envelope on the floor and the pink ribbon beside it.", "disputed": false, "n_passes": 1}, {"doc_id": "ch087", "global_index": 87, "label_ko": "12편 8장", "quote": "and that the witness had received them from Smerdyakov the day before.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Lizaveta Smerdyastchaya" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">91</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch091", "global_index": 91, "label_ko": "12편 12장", "quote": "he remembered that he was the son of ‘stinking Lizaveta.’", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Smerdyakov" target="Murder of Mitya's father" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">59</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch059", "global_index": 59, "label_ko": "9편 6장", "quote": "It’s he who’s murdered him! He’s robbed him! No one else knew where the old man hid the envelope.", "disputed": true, "n_passes": 1}, {"doc_id": "ch088", "global_index": 88, "label_ko": "12편 9장", "quote": "He leapt up and shouted to us, ‘Then Smerdyakov murdered him, it was Smerdyakov!’", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Marya Kondratyevna's lodging" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">74</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "Smerdyakov, who was ill—almost dying—had been with them ever since Fyodor Pavlovitch’s death.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Murder of his father" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">76</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "it’s simply because I suspect you of that crime and I’ll drag you to justice.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Marya Kondratyevna’s cottage" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "In the passage, Marya Kondratyevna, who ran out to open the door with a candle in her hand, whispered that Smerdyakov was very ill", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Iron paper-weight" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I snatched up that iron paper-weight from his table; do you remember, weighing about three pounds? I swung it and hit him on the top of the skull with the corner of it.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Moscow" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">19</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch019", "global_index": 19, "label_ko": "3편 6장", "quote": "sent him to Moscow to be trained. He spent some years there and came back remarkably changed in appearance.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Murder of Dmitri's father" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">59</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch059", "global_index": 59, "label_ko": "9편 6장", "quote": "“It’s he who’s murdered him! He’s robbed him! No one else knew where the old man hid the envelope. It’s Smerdyakov, that’s clear, now!”", "disputed": true, "n_passes": 1}, {"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "if I don’t beat you to death, it’s simply because I suspect you of that crime and I’ll drag you to justice.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="The murder" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">75</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch075", "global_index": 75, "label_ko": "11편 6장", "quote": "he refused to entertain a suspicion against Mitya, and spoke openly of Smerdyakov as the murderer.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Iron Paper-weight" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I snatched up that iron paper-weight from his table; do you remember, weighing about three pounds? I swung it and hit him on the top of the skull with the corner of it.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smerdyakov" target="Three Thousand Roubles" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">77</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch077", "global_index": 77, "label_ko": "11편 8장", "quote": "I wiped the paper-weight, put it back, went up to the ikons, took the money out of the envelope, and flung the envelope on the floor and the pink ribbon beside it.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Dmitri Fyodorovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">18</data>
  <data key="d8">10</data>
  <data key="d9">[{"doc_id": "ch018", "global_index": 18, "label_ko": "3편 5장", "quote": "‘I love you madly,’ she says, ‘even if you don’t love me, never mind. Be my husband.", "disputed": true, "n_passes": 3}, {"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "all the tragedy of her position in relation to the man she loved so dearly was no secret to her", "disputed": false, "n_passes": 3}, {"doc_id": "ch026", "global_index": 26, "label_ko": "4편 2장", "quote": "Nothing will induce her to abandon him.", "disputed": false, "n_passes": 3}, {"doc_id": "ch028", "global_index": 28, "label_ko": "4편 4장", "quote": "she is doing her utmost to persuade herself she loves your brother, Dmitri.", "disputed": true, "n_passes": 3}, {"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "Besides all this, Alyosha had till the evening before implicitly believed that Katerina Ivanovna had a steadfast and passionate love for Dmitri; but he had only believed it till the evening before.", "disputed": true, "n_passes": 6}, {"doc_id": "ch075", "global_index": 75, "label_ko": "11편 6장", "quote": "Ivan looked with indignation on Katerina Ivanovna’s love for his brother.", "disputed": false, "n_passes": 3}, {"doc_id": "ch080", "global_index": 80, "label_ko": "12편 1장", "quote": "All sorts of extraordinary tales were told about her, amazing anecdotes of her passion for Mitya, in spite of his crime.", "disputed": true, "n_passes": 3}, {"doc_id": "ch084", "global_index": 84, "label_ko": "12편 5장", "quote": "I tried to conquer him by my love—a love that knew no bounds.", "disputed": false, "n_passes": 1}, {"doc_id": "ch094", "global_index": 94, "label_ko": "13편 1장", "quote": "he instantly imagined I was jealous of Dmitri and that I still loved Dmitri.", "disputed": true, "n_passes": 2}, {"doc_id": "ch095", "global_index": 95, "label_ko": "13편 2장", "quote": "to tell you again that you are my god, my joy, to tell you that I love you madly", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Dmitri Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">24</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch024", "global_index": 24, "label_ko": "3편 11장", "quote": "and Katerina Ivanovna’s cry: “Your brother is a scoundrel!”", "disputed": false, "n_passes": 2}, {"doc_id": "ch060", "global_index": 60, "label_ko": "9편 7장", "quote": "she’d have given it to satisfy her vengeance, to show her contempt for me, for hers is an infernal nature, too, and she’s a woman of great wrath.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Dmitri Fyodorovitch Karamazov" id="ENGAGED_TO">
  <data key="d6">ENGAGED_TO</data>
  <data key="d7">29</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "a desire to assist him from me, Dmitri Fyodorovitch’s betrothed, not from himself.... But you know....", "disputed": false, "n_passes": 3}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "Katerina Ivanovna replied firmly that she had been formerly betrothed to the prisoner, “until he left me of his own accord...”", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Dmitri Fyodorovitch Karamazov" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">83</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "I was once indebted to him for assistance in money for more than three thousand, and I took it, although I could not at that time foresee that I should ever be in a position to repay my debt.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Katerina Ivanovna" target="house in the High Street" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">23</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "Alyosha entered the very spacious and convenient house in the High Street occupied by Katerina Ivanovna.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Grushenka" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">23</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "Katerina Ivanovna at once made her sit down in an arm-chair facing Alyosha, and ecstatically kissed her several times on her smiling lips. She seemed quite in love with her.", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Grushenka" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">23</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "“Insolent creature!” cried Katerina Ivanovna, as though suddenly grasping something.", "disputed": false, "n_passes": 6}, {"doc_id": "ch095", "global_index": 95, "label_ko": "13편 2장", "quote": "“We are full of hatred, my girl, you and I! We are both full of hatred! As though we could forgive one another!", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Grushenka" id="RIVAL_OF">
  <data key="d6">RIVAL_OF</data>
  <data key="d7">23</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "Now again I’m thinking: I may take to Mitya again. I liked him very much once—liked him for almost a whole hour. Now maybe I shall go and tell him to stay with me from this day forward.", "disputed": false, "n_passes": 1}, {"doc_id": "ch080", "global_index": 80, "label_ko": "12편 1장", "quote": "The public was looking forward with anxious curiosity to the meeting of the two rivals—the proud aristocratic girl and “the hetaira.”", "disputed": false, "n_passes": 3}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "The woman who came between us has ruined him; she is the cause of it all, let me tell you", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Ivan Fyodorovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">28</data>
  <data key="d8">9</data>
  <data key="d9">[{"doc_id": "ch028", "global_index": 28, "label_ko": "4편 4장", "quote": "She loves your brother, Ivan, and she is doing her utmost to persuade herself she loves your brother, Dmitri.", "disputed": true, "n_passes": 3}, {"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "Now Alyosha was impressed by Madame Hohlakov’s blunt and persistent assertion that Katerina Ivanovna was in love with Ivan, and only deceived herself through some sort of pose", "disputed": true, "n_passes": 9}, {"doc_id": "ch034", "global_index": 34, "label_ko": "5편 3장", "quote": "it may take her fifteen or twenty years to find out that she doesn’t care for Dmitri, and loves me whom she torments", "disputed": true, "n_passes": 3}, {"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "“Katerina Ivanovna loves you, brother,” said Alyosha sadly.", "disputed": true, "n_passes": 3}, {"doc_id": "ch075", "global_index": 75, "label_ko": "11편 6장", "quote": "did not abandon herself altogether to the man she loved, in spite of the Karamazov violence of his passions and the great fascination he had for her.", "disputed": false, "n_passes": 2}, {"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "And just at that time his relations with Katerina Ivanovna became acutely strained. They were like two enemies in love with one another.", "disputed": false, "n_passes": 3}, {"doc_id": "ch084", "global_index": 84, "label_ko": "12편 5장", "quote": "this time it was for another, and perhaps only now—perhaps only at this moment—she felt and knew how dear that other was to her!", "disputed": false, "n_passes": 1}, {"doc_id": "ch094", "global_index": 94, "label_ko": "13편 1장", "quote": "when I myself had told him long before that I did not love Dmitri, that I loved no one but him!", "disputed": false, "n_passes": 2}, {"doc_id": "ch095", "global_index": 95, "label_ko": "13편 2장", "quote": "She understands now, I think, that Katya no longer cares for me, but loves Ivan.", "disputed": true, "n_passes": 2}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Ivan Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">74</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "Alyosha saw at once that she had asked Ivan that question before, perhaps only a moment before he came in, and not for the first time, but for the hundredth, and that they had ended by quarreling.", "disputed": false, "n_passes": 2}, {"doc_id": "ch094", "global_index": 94, "label_ko": "13편 1장", "quote": "He had told me the main idea three days before, and we began quarreling about it at once and quarreled for three days.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Mitya's letter" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">74</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "She’s got a document in her hands, in Mitya’s own writing, that proves conclusively that he did murder Fyodor Pavlovitch.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Katerina Ivanovna's house" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">74</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "On the way to Ivan he had to pass the house where Katerina Ivanovna was living.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Mitya's letter to Katerina Ivanovna" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">76</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "When Katerina Ivanovna heard that, she got up from her seat without a word, went to her writing-table, opened a box standing on it, took out a sheet of paper and laid it before Ivan.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Agafya Ivanovna" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">17</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch017", "global_index": 17, "label_ko": "3편 4장", "quote": "This second daughter is Katerina Ivanovna, and she was the child of the second wife, who belonged to a distinguished general’s family", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Two hundred-rouble notes" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">29</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "She had two hundred-rouble notes in her hand.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Dmitri's letter" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">76</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch076", "global_index": 76, "label_ko": "11편 7장", "quote": "When Katerina Ivanovna heard that, she got up from her seat without a word, went to her writing-table, opened a box standing on it, took out a sheet of paper and laid it before Ivan.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Two hundred roubles" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">29</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "She had two hundred-rouble notes in her hand.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="Mitya's document" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">74</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "She’s got a document in her hands, in Mitya’s own writing, that proves conclusively that he did murder Fyodor Pavlovitch.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Katerina Ivanovna" target="letter from Mitya" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">84</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch084", "global_index": 84, "label_ko": "12편 5장", "quote": "Then I brought out that letter and showed it him.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="Katerina Ivanovna" id="RIVAL_OF">
  <data key="d6">RIVAL_OF</data>
  <data key="d7">23</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "I may take to Mitya again. I liked him very much once—liked him for almost a whole hour. Now maybe I shall go and tell him to stay with me from this day forward.", "disputed": false, "n_passes": 2}, {"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "The object of that uneasiness was the same as ever—Katerina Ivanovna, of whom Grushenka had even raved when she lay in delirium. Alyosha knew that she was fearfully jealous of her.", "disputed": false, "n_passes": 3}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "As for the rivalry of the two “ladies,” as the prosecutor expressed it—that is, of Grushenka and Katya—he answered evasively", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Grushenka" target="Katerina Ivanovna" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">23</data>
  <data key="d8">7</data>
  <data key="d9">[{"doc_id": "ch023", "global_index": 23, "label_ko": "3편 10장", "quote": "“So I shall tell Mitya how you kissed my hand, but I didn’t kiss yours at all. And how he will laugh!”", "disputed": false, "n_passes": 4}, {"doc_id": "ch024", "global_index": 24, "label_ko": "3편 11장", "quote": "And she flung it in her face just now that she had gone to gentlemen in secret to sell her beauty!", "disputed": false, "n_passes": 2}, {"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "I did insult her dreadfully. She sent for me, she wanted to make a conquest of me", "disputed": false, "n_passes": 3}, {"doc_id": "ch046", "global_index": 46, "label_ko": "8편 1장", "quote": "on the evening when Grushenka had insulted Katerina Ivanovna, and Mitya, after hearing Alyosha’s account of it, had admitted that he was a scoundrel", "disputed": false, "n_passes": 3}, {"doc_id": "ch053", "global_index": 53, "label_ko": "8편 8장", "quote": "If you love her, I shall strangle her.... I’ll put out both her eyes with a needle....", "disputed": false, "n_passes": 1}, {"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "You wait, I’ll make it hot for Katerina at the trial! I’ll just say a word then ... I’ll tell everything then!", "disputed": false, "n_passes": 1}, {"doc_id": "ch095", "global_index": 95, "label_ko": "13편 2장", "quote": "“We are full of hatred, my girl, you and I! We are both full of hatred! As though we could forgive one another!", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Grushenka" target="Alexey Fyodorovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">17</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch017", "global_index": 17, "label_ko": "3편 4장", "quote": "That rogue Grushenka has an eye for men. She told me once that she’d devour you one day.", "disputed": true, "n_passes": 2}, {"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "You see, I love him with all my soul, that’s how it is! Alyosha, do you believe I love you with all my soul?", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Grushenka" target="Rakitin" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "Take it. Rakitin, I owe it you, there’s no fear of your refusing it, you asked for it yourself.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Grushenka" target="Rakitin" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "And you hush, Rakitin, because you are telling lies.", "disputed": false, "n_passes": 5}]</data>
</edge>
<edge source="Grushenka" target="Rakitin" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">12</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch012", "global_index": 12, "label_ko": "2편 7장", "quote": "Oh, yes, I’d forgotten she was a relation of yours.” “A relation! That Grushenka a relation of mine!”", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="Dmitri Fyodorovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">44</data>
  <data key="d8">10</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "And add, too, that Grushenka loved him only one hour, only one short hour she loved him", "disputed": false, "n_passes": 3}, {"doc_id": "ch046", "global_index": 46, "label_ko": "8편 1장", "quote": "Though Grushenka had, it is true, loved him for an hour, genuinely and sincerely, yet she tortured him sometimes cruelly and mercilessly.", "disputed": true, "n_passes": 4}, {"doc_id": "ch050", "global_index": 50, "label_ko": "8편 5장", "quote": "to give him, Mitya, her greetings, and to tell him “to remember for ever how she had loved him for an hour.”", "disputed": false, "n_passes": 3}, {"doc_id": "ch053", "global_index": 53, "label_ko": "8편 8장", "quote": "She was ashamed, and from her eyes he could see now whom she loved. Now he had everything to make life happy", "disputed": true, "n_passes": 9}, {"doc_id": "ch056", "global_index": 56, "label_ko": "9편 3장", "quote": "Why such love for me? How can a clumsy, ugly brute like me, with my ugly face, deserve such love, that she is ready to go to exile with me?", "disputed": false, "n_passes": 3}, {"doc_id": "ch061", "global_index": 61, "label_ko": "9편 8장", "quote": "Mitya’s position with Agrafena Alexandrovna had certainly improved, and that she had said that she loved him.", "disputed": true, "n_passes": 3}, {"doc_id": "ch062", "global_index": 62, "label_ko": "9편 9장", "quote": "I have told you I am yours, and I will be yours. I will follow you for ever, wherever they may send you.", "disputed": false, "n_passes": 3}, {"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "And she tortures me, tortures me with her love.", "disputed": false, "n_passes": 3}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "When the prisoner was arrested at Mokroe,” the prosecutor asked, “every one saw and heard you run out of the next room and cry out: ‘It’s all my fault. We’ll go to Siberia together!’", "disputed": false, "n_passes": 1}, {"doc_id": "ch088", "global_index": 88, "label_ko": "12편 9장", "quote": "when he learnt that she loved him, that for his sake she had rejected her first lover, that she was summoning him, Mitya, to a new life", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Grushenka" target="Dmitri Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">44</data>
  <data key="d8">4</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "Be quiet, Rakitin, don’t remind me of Dmitri Fyodorovitch, he has bruised my heart.", "disputed": false, "n_passes": 1}, {"doc_id": "ch052", "global_index": 52, "label_ko": "8편 7장", "quote": "“Hold your tongue, you, anyway! Sit down, you stupid!” Grushenka scolded with angry annoyance.", "disputed": false, "n_passes": 6}, {"doc_id": "ch053", "global_index": 53, "label_ko": "8편 8장", "quote": "You will forgive me for having tormented you? It was through spite I tormented you all. It was for spite I drove the old man out of his mind....", "disputed": false, "n_passes": 1}, {"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "We quarreled again, would you believe it? Whenever I go we quarrel.” Grushenka said all this in one breath in her agitation.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Grushenka" target="Dmitri Fyodorovitch Karamazov" id="ENGAGED_TO">
  <data key="d6">ENGAGED_TO</data>
  <data key="d7">70</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "betrothed to a man who had been arrested for a terrible crime, almost at the instant of their betrothal, in spite of her illness and the almost inevitable sentence hanging over Mitya", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Grushenka" target="widow Morozov's house" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">49</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch049", "global_index": 49, "label_ko": "8편 4장", "quote": "inform him with a good-humored smile that “Agrafena Alexandrovna is not at home now, you know.”", "disputed": false, "n_passes": 1}, {"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "Alyosha went towards the cathedral square to the widow Morozov’s house to see Grushenka", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Grushenka" target="Plastunovs' inn" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">51</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch051", "global_index": 51, "label_ko": "8편 6장", "quote": "Not at the posting-station, but at Plastunov’s, at the inn, where they let out horses, too.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="Pan Vrublevsky" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">52</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch052", "global_index": 52, "label_ko": "8편 7장", "quote": "“Don’t dare to shout like that,” cried Grushenka. “Ah, you turkey-cocks!”", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Grushenka" target="Kuzma" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">52</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch052", "global_index": 52, "label_ko": "8편 7장", "quote": "it wasn’t virtue kept me pure, and it wasn’t that I was afraid of Kuzma, but that I might hold up my head when I met him, and tell him he’s a scoundrel.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Grushenka" target="Mokroe" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">60</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch060", "global_index": 60, "label_ko": "9편 7장", "quote": "her, she’s sitting down below now, Grushenka. I carried her off here to Mokroe then", "disputed": false, "n_passes": 1}, {"doc_id": "ch086", "global_index": 86, "label_ko": "12편 7장", "quote": "Had the maid told him that her mistress was at Mokroe with her former lover, nothing would have happened.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Grushenka" target="Mokroe" id="OCCURRED_AT">
  <data key="d6">OCCURRED_AT</data>
  <data key="d7">73</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "His abuse of her at Mokroe weighed on the old man’s conscience", "disputed": false, "n_passes": 1}]</data>
</edge>
