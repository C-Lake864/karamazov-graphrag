  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch050", "global_index": 50, "label_ko": "8편 5장", "quote": "Just ten minutes later Dmitri went in to Pyotr Ilyitch Perhotin, the young official with whom he had pawned his pistols.", "disputed": false, "n_passes": 1}]</data>
