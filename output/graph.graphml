  <data key="d9">[{"doc_id": "ch091", "global_index": 91, "label_ko": "12편 12장", "quote": "leapt off the fence a minute later to the assistance of Grigory after he had, in his excitement, knocked him down.", "disputed": false, "n_passes": 1}]</data>
</edge>
