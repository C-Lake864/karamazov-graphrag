<edge source="Mihail Mihailovitch" target="Grushenka" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">73</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "His abuse of her at Mokroe weighed on the old man’s conscience, and when he learned the whole story, he completely changed his view of her.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Marya Kondratyevna" target="Marya Kondratyevna's lodging" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">74</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch074", "global_index": 74, "label_ko": "11편 5장", "quote": "She had sold their little house, and was now living here with her mother.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Marya Kondratyevna" target="Fyodor Pavlovitch’s house" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "From Marya Kondratyevna (the woman living near Fyodor Pavlovitch’s) he learned the very disturbing fact of Smerdyakov’s illness.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Count Mattei" target="Milan" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">78</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch078", "global_index": 78, "label_ko": "11편 9장", "quote": "In despair I wrote to Count Mattei in Milan. He sent me a book and some drops, bless him, and, only fancy, Hoff’s malt extract cured me!", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Korovkin" target="Moscow" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">78</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch078", "global_index": 78, "label_ko": "11편 9장", "quote": "I was seventeen then, I was at the high school. I made up that anecdote and told it to a schoolfellow called Korovkin, it was at Moscow....", "disputed": false, "n_passes": 2}]</data>
</edge>
