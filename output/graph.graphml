  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch017", "global_index": 17, "label_ko": "3편 4장", "quote": "‘Ah, you scoundrel!’—that’s what she said. ‘You wicked scoundrel! How dare you!’", "disputed": false, "n_passes": 1}]</data>
</edge>
