  <data key="d6">LIVES_AT</data>
  <data key="d7">67</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "Varvara had been gone for some time past to Petersburg to study at the university", "disputed": false, "n_passes": 3}]</data>
