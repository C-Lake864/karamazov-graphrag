  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "I stood on one side to direct the goose. And the owner wasn’t looking, he was talking to some one", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Kolya Krassotkin" target="The goose incident" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">67</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "‘It wasn’t me,’ he said, ‘it was he egged me on,’ and he pointed to me.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Kolya Krassotkin" target="The railway incident" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">67</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "How could you lie still on the line? Is it possible you weren’t the least afraid, lying there under the train?", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Smurov" target="Wisp of tow" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">27</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch027", "global_index": 27, "label_ko": "4편 3장", "quote": "But Smurov, the left-handed boy, needed no telling, and at once revenged himself; he threw a stone", "disputed": false, "n_passes": 1}]</data>
