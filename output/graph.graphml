  <data key="d7">93</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch093", "global_index": 93, "label_ko": "12편 14장", "quote": "As for the prosecutor’s charge of uttering unorthodox opinions, Fetyukovitch hinted that it was a personal insinuation", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Fetyukovitch" target="trial of Dmitri Karamazov" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">80</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch080", "global_index": 80, "label_ko": "12편 1장", "quote": "Everybody was excited at the presence of the celebrated lawyer, Fetyukovitch.", "disputed": false, "n_passes": 1}]</data>
</edge>
