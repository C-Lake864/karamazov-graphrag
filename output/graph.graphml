  <data key="d9">[{"doc_id": "ch080", "global_index": 80, "label_ko": "12편 1장", "quote": "At the same moment the counsel for defense, the celebrated Fetyukovitch, entered, and a sort of subdued hum passed through the court.", "disputed": false, "n_passes": 2}, {"doc_id": "ch093", "global_index": 93, "label_ko": "12편 14장", "quote": "Fetyukovitch concluded his speech with a bow, amid a hum of approbation in the court.", "disputed": false, "n_passes": 1}]</data>
