<edge source="Kuzma Kuzmitch Samsonov" target="Grushenka" id="RAISED">
  <data key="d6">RAISED</data>
  <data key="d7">44</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "though Grushenka had been raised from destitution by the old man, Samsonov", "disputed": true, "n_passes": 3}, {"doc_id": "ch083", "global_index": 83, "label_ko": "12편 4장", "quote": "He was my benefactor; he took me when I hadn’t a shoe to my foot, when my family had turned me out.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Kuzma Kuzmitch Samsonov" target="Grushenka" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "He helped Grushenka with his advice to increase her capital and put business in her way.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Kuzma Kuzmitch Samsonov" target="Grushenka" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">46</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch046", "global_index": 46, "label_ko": "8편 1장", "quote": "or his jealousy of Grushenka, in whose name this “scapegrace” had rushed in on him with such a tale to get money which worked on the old man, I can’t tell.", "disputed": true, "n_passes": 1}]</data>
</edge>
