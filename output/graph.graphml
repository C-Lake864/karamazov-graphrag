  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "she had taken in Grushenka as a lodger, four years before, solely to please her kinsman, the merchant Samsonov, who was known to be the girl’s protector.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Fenya" target="Grushenka" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">44</data>
  <data key="d8">5</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "her granddaughter, a smart young girl of twenty, who performed the duties of a maid.", "disputed": false, "n_passes": 8}, {"doc_id": "ch050", "global_index": 50, "label_ko": "8편 5장", "quote": "how she, Fenya, had stood on the watch, how the mistress had set off", "disputed": false, "n_passes": 5}, {"doc_id": "ch051", "global_index": 51, "label_ko": "8편 6장", "quote": "Why, Fenya threw herself at your feet just now, and begged you not to harm her mistress, and some one else, too", "disputed": false, "n_passes": 1}, {"doc_id": "ch054", "global_index": 54, "label_ko": "9편 1장", "quote": "He’ll go to Mokroe, I thought, and kill my mistress there. I ran out to beg him not to kill her.", "disputed": false, "n_passes": 1}, {"doc_id": "ch070", "global_index": 70, "label_ko": "11편 1장", "quote": "Fenya asked her mistress: “Is the gentleman going to stay the night, mistress?” “Yes; make him a bed on the sofa,” answered Grushenka.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Fenya" target="widow Morozov's house" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">54</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch054", "global_index": 54, "label_ko": "9편 1장", "quote": "Pyotr Ilyitch Perhotin, whom we left knocking at the strong locked gates of the widow Morozov’s house, ended, of course, by making himself heard.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Matryona" target="Grushenka" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">44</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch044", "global_index": 44, "label_ko": "7편 3장", "quote": "I used to hear it when I was a child from Matryona, my cook, who is still with me.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Matryona" target="Fenya" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "Fenya was sitting with her grandmother, the old cook, Matryona, in the kitchen", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Lyagavy" target="Ilyinskoe" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">46</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch046", "global_index": 46, "label_ko": "8편 1장", "quote": "Now he’s come back again and is staying with the priest at Ilyinskoe, about twelve versts from the Volovya station.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Lyagavy" target="Fyodor Pavlovitch Karamazov" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">46</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch046", "global_index": 46, "label_ko": "8편 1장", "quote": "He’s been haggling with Fyodor Pavlovitch for the last year, over your copse at Tchermashnya. They can’t agree on the price, maybe you’ve heard?", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Lyagavy" target="Fyodor Pavlovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">46</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch046", "global_index": 46, "label_ko": "8편 1장", "quote": "He’s been haggling with Fyodor Pavlovitch for the last year, over your copse at Tchermashnya.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Lyagavy" target="Dmitri Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">47</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch047", "global_index": 47, "label_ko": "8편 2장", "quote": "“No, you show me this: you tell me the law that allows roguery. D’you hear? You’re a scoundrel! Do you understand that?”", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Gorstkin" target="Suhoy Possyolok" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">47</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch047", "global_index": 47, "label_ko": "8편 2장", "quote": "he was now at Suhoy Possyolok, that he was staying the night in the forester’s cottage, as he was buying timber there too.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Madame Belmesov" target="Madame Hohlakov" id="RELATED_TO">
  <data key="d6">RELATED_TO</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "You have most likely heard of my cousin, Madame Belmesov.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Shtchedrin" target="Madame Hohlakov" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">48</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch048", "global_index": 48, "label_ko": "8편 3장", "quote": "He has taught me so much, so much about the vocation of woman. So last year I sent him an anonymous letter of two lines: ‘I kiss and embrace you, my teacher, for the modern woman. Persevere.’", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Nazar Ivanovitch" target="widow Morozov" id="SERVANT_OF">
  <data key="d6">SERVANT_OF</data>
  <data key="d7">49</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch049", "global_index": 49, "label_ko": "8편 4장", "quote": "Nazar Ivanovitch promised, but went upstairs to his mistress who had suddenly sent for him", "disputed": false, "n_passes": 2}]</data>
</edge>
