  <data key="d6">BROTHER_OF</data>
  <data key="d7">17</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch017", "global_index": 17, "label_ko": "3편 4장", "quote": "I am speaking figuratively, brother. In the town I was in, there were no such back-alleys in the literal sense, but morally there were.", "disputed": false, "n_passes": 1}]</data>
</edge>
