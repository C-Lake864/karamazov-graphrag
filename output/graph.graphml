  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "Smurov, with the captain’s hat in his hand, was crying bitterly too", "disputed": false, "n_passes": 1}]</data>
