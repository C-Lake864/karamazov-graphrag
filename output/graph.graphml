  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch040", "global_index": 40, "label_ko": "6편 2장", "quote": "But she had already given her heart to another man, an officer of noble birth and high rank in the service, who was at that time away at the front, though she was expecting him soon to return.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Mysterious Visitor" target="Landowner's Widow" id="LOVES">
