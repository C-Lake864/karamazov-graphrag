  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch080", "global_index": 80, "label_ko": "12편 1장", "quote": "It was said that Ippolit Kirillovitch was in a tremor at meeting Fetyukovitch, and that they had been enemies from the beginning of their careers in Petersburg", "disputed": true, "n_passes": 2}, {"doc_id": "ch088", "global_index": 88, "label_ko": "12편 9장", "quote": "He had no business to make a thrust at the Petersburg man like that; ‘appealing to your sensibilities’—do you remember?", "disputed": false, "n_passes": 1}]</data>
</edge>
