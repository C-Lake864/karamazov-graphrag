  <data key="d9">[{"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "At the time fixed, Kolya lay down between the rails.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Perezvon" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">63</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "“Perezvon,” the big, shaggy, mangy dog, which he had picked up a month before, brought home, and kept for some reason secretly indoors", "disputed": false, "n_passes": 2}, {"doc_id": "ch066", "global_index": 66, "label_ko": "10편 4장", "quote": "“And as soon as I saw you with a dog, I thought it was Zhutchka you were bringing.” “Wait a bit, Karamazov, perhaps we shall find it yet; but this is Perezvon.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Agafya Ivanovna" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">64</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch064", "global_index": 64, "label_ko": "10편 2장", "quote": "“Why are you late, female?” asked Krassotkin sternly. “Female, indeed! Go on with you, you brat.”", "disputed": false, "n_passes": 5}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Ilusha" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">65</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch065", "global_index": 65, "label_ko": "10편 3장", "quote": "You are going yourself now to make it up with Ilusha.", "disputed": false, "n_passes": 1}, {"doc_id": "ch066", "global_index": 66, "label_ko": "10편 4장", "quote": "the same day he’d been throwing stones and had bitten your finger—but you understand now what a state he was in!", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Ilusha" id="MENTOR_OF">
  <data key="d6">MENTOR_OF</data>
  <data key="d7">66</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch066", "global_index": 66, "label_ko": "10편 4장", "quote": "I am teaching him, developing him. Why shouldn’t I develop him if I like him?", "disputed": false, "n_passes": 3}, {"doc_id": "ch068", "global_index": 68, "label_ko": "10편 6장", "quote": "I quite understand why you have had such an influence on this generous, morbidly sensitive boy", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Ilusha" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">96</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "“Ah, how I loved him!” exclaimed Kolya.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Marya" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">65</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch065", "global_index": 65, "label_ko": "10편 3장", "quote": "You set upon me, you impudent young monkey. I didn’t say anything,” bawled Marya.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Rakitin" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">68</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch068", "global_index": 68, "label_ko": "10편 6장", "quote": "I often disagree with Mr. Rakitin. Though I mention Tatyana, I am not at all for the emancipation of women.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Alexey Fyodorovitch Karamazov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">68</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch068", "global_index": 68, "label_ko": "10편 6장", "quote": "I did. I loved you awfully. I’ve been loving and dreaming of you.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Ilusha's Funeral" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
  <data key="d7">96</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "when we recall how we buried Ilusha, how we loved him in his last days", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Smaragdov" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">67</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "a secret which could only be discovered by reading Smaragdov, and no one had Smaragdov but Kolya.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Kolya Krassotkin" target="Kartashov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">67</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "“Before you talk of a historical event like the foundation of a nationality, you must first understand what you mean by it,” he admonished him in stern, incisive tones.", "disputed": false, "n_passes": 2}, {"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "“I beg you most earnestly, Kartashov, not to interrupt again with your idiotic remarks, especially when one is not talking to you and doesn’t care to know whether you exist or not!”", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Kolya Krassotkin" target="The Bell" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">68</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch068", "global_index": 68, "label_ko": "10편 6장", "quote": "What if he should find out that I’ve only that one number of _The Bell_ in father’s bookcase", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Kolya Krassotkin" target="The goose incident" id="PRESENT_AT">
  <data key="d6">PRESENT_AT</data>
