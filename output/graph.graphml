  <data key="d9">[{"doc_id": "ch040", "global_index": 40, "label_ko": "6편 2장", "quote": "He fell passionately in love with her, declared his feeling and tried to persuade her to marry him.", "disputed": false, "n_passes": 1}]</data>
</edge>
