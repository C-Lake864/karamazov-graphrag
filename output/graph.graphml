<edge source="Ilusha" target="Alexey Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">30</data>
  <data key="d8">4</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "And then he rushed at me and bit my finger badly, I don’t know why.", "disputed": false, "n_passes": 6}, {"doc_id": "ch031", "global_index": 31, "label_ko": "4편 7장", "quote": "did Ilusha hurt your finger much? I didn’t like to go into it in our mansion before him.” “Yes, very much, and he was in a great fury. He was avenging you on me as a Karamazov, I see that now.", "disputed": false, "n_passes": 2}, {"doc_id": "ch066", "global_index": 66, "label_ko": "10편 4장", "quote": "And then I heard that the same day he’d been throwing stones and had bitten your finger", "disputed": true, "n_passes": 3}, {"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "He had not been to school since the day he met Alyosha and bit his finger.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Ilusha" target="Captain Snegiryov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">30</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "So your boy is a good boy, he loves his father, and he attacked me as the brother of your assailant.", "disputed": false, "n_passes": 4}]</data>
</edge>
<edge source="Ilusha" target="Arina Petrovna" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">30</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "There’s only Ilusha who comes home from school and loves me. Yesterday he brought me an apple.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Ilusha" target="Kolya Krassotkin" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">31</data>
  <data key="d8">4</data>
  <data key="d9">[{"doc_id": "ch031", "global_index": 31, "label_ko": "4편 7장", "quote": "They say he stabbed a boy called Krassotkin with a pen-knife not long ago.", "disputed": true, "n_passes": 3}, {"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "Kolya Krassotkin was the boy stabbed with a penknife by the boy already known to the reader as the son of Captain Snegiryov. Ilusha had been defending his father", "disputed": false, "n_passes": 3}, {"doc_id": "ch066", "global_index": 66, "label_ko": "10편 4장", "quote": "he pulled out a penknife, rushed at me, and struck at my thigh, here in my right leg.", "disputed": false, "n_passes": 5}, {"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "Perhaps the bitterest of all his bitter memories was his stabbing Krassotkin, who had been his one friend and protector.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Ilusha" target="Madame Snegiryov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">67</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "Ilusha, darling, he’s the one who loves his mamma!", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Ilusha" target="Nina" id="BROTHER_OF">
  <data key="d6">BROTHER_OF</data>
  <data key="d7">67</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "Nina, Ilusha’s gentle, crippled sister, did not like her father’s buffoonery either", "disputed": false, "n_passes": 2}, {"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "Nina pressed her lips to her brother’s for the last time as they bore the coffin by her.", "disputed": false, "n_passes": 2}]</data>
</edge>
