<edge source="Captain Snegiryov" target="Lake Street" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">29</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch029", "global_index": 29, "label_ko": "4편 5장", "quote": "He lives in Lake Street, in the house of a woman called Kalmikov....", "disputed": false, "n_passes": 3}, {"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "At last he found the house in Lake Street. It was a decrepit little house", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Captain Snegiryov" target="Ilusha" id="FATHER_OF">
  <data key="d6">FATHER_OF</data>
  <data key="d7">30</data>
  <data key="d8">5</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "That I’d take my Ilusha and thrash him before you for your satisfaction?", "disputed": false, "n_passes": 6}, {"doc_id": "ch063", "global_index": 63, "label_ko": "10편 1장", "quote": "already known to the reader as the son of Captain Snegiryov. Ilusha had been defending his father", "disputed": false, "n_passes": 3}, {"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "His father was terribly concerned about him. He even gave up drinking and was almost crazy with terror that his boy would die.", "disputed": false, "n_passes": 4}, {"doc_id": "ch081", "global_index": 81, "label_ko": "12편 2장", "quote": "Ilusha, my little son. ‘Father, father, how he insulted you!’ He said that at the stone. Now he is dying....", "disputed": false, "n_passes": 3}, {"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "“Father will cry, be with father,” Ilusha had told them as he lay dying, and the boys remembered it.", "disputed": false, "n_passes": 4}]</data>
</edge>
<edge source="Captain Snegiryov" target="Varvara" id="FATHER_OF">
  <data key="d6">FATHER_OF</data>
  <data key="d7">30</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "Wait a little, Varvara!” cried her father, speaking peremptorily but looking at her quite approvingly.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Captain Snegiryov" target="Nina" id="FATHER_OF">
  <data key="d6">FATHER_OF</data>
  <data key="d7">30</data>
  <data key="d8">3</data>
  <data key="d9">[{"doc_id": "ch030", "global_index": 30, "label_ko": "4편 6장", "quote": "This girl sitting here is my daughter Nina; I forgot to introduce her to you.", "disputed": false, "n_passes": 3}, {"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "Nina, Ilusha’s gentle, crippled sister, did not like her father’s buffoonery either", "disputed": false, "n_passes": 2}, {"doc_id": "ch096", "global_index": 96, "label_ko": "13편 3장", "quote": "“Father, give mother a flower!” said Nina, lifting her face wet with tears.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Captain Snegiryov" target="Captain Snegiryov’s lodging" id="LIVES_AT">
  <data key="d6">LIVES_AT</data>
  <data key="d7">65</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch065", "global_index": 65, "label_ko": "10편 3장", "quote": "The boys made haste and they walked as far as Captain Snegiryov’s lodging, a considerable distance, quickly and almost in silence.", "disputed": false, "n_passes": 1}]</data>
</edge>
