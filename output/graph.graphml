  <data key="d9">[{"doc_id": "ch065", "global_index": 65, "label_ko": "10편 3장", "quote": "The boys made haste and they walked as far as Captain Snegiryov’s lodging, a considerable distance, quickly and almost in silence.", "disputed": false, "n_passes": 2}]</data>
