  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">65</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch065", "global_index": 65, "label_ko": "10편 3장", "quote": "He was—if the reader has not forgotten—one of the group of boys who two months before had thrown stones at Ilusha.", "disputed": false, "n_passes": 3}]</data>
</edge>
