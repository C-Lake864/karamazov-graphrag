  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch064", "global_index": 64, "label_ko": "10편 2장", "quote": "She seemed quite pleased, in fact, to enjoy a skirmish with her merry young master.", "disputed": false, "n_passes": 3}]</data>
</edge>
<edge source="Agafya Ivanovna" target="Karamazov" id="QUARRELS_WITH">
