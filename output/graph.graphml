  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch067", "global_index": 67, "label_ko": "10편 5장", "quote": "A carriage belonging to Madame Hohlakov drove up to the gate.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Madame Hohlakov" target="Rakitin" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">71</data>
  <data key="d8">2</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "I got up suddenly and said to Rakitin, ‘It’s painful for me to say it, but I don’t wish to see you in my house again.’ So I turned him out.", "disputed": false, "n_passes": 4}, {"doc_id": "ch073", "global_index": 73, "label_ko": "11편 4장", "quote": "And wasn’t he angry when she kicked him out! He was gnashing his teeth!”", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Madame Hohlakov" target="Alexey Fyodorovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">32</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch032", "global_index": 32, "label_ko": "5편 1장", "quote": "“Alexey Fyodorovitch, this is awful. This is all childish nonsense and ridiculous. I trust you won’t dream—It’s foolishness, nothing but foolishness!” she said, attacking him at once.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Madame Hohlakov" target="Father Zossima" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">43</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch043", "global_index": 43, "label_ko": "7편 2장", "quote": "‘she would never have expected _such conduct_ from a man of such a reverend character as Father Zossima.’ That was her very word: ‘conduct.’ She is angry too.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Madame Hohlakov" target="Short poem on bad foot" id="POSSESSES">
  <data key="d6">POSSESSES</data>
  <data key="d7">71</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch071", "global_index": 71, "label_ko": "11편 2장", "quote": "I can never remember poetry. I’ve got it here. I’ll show it to you later.", "disputed": false, "n_passes": 1}]</data>
</edge>
