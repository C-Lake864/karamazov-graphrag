  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch036", "global_index": 36, "label_ko": "5편 5장", "quote": "My story is laid in Spain, in Seville, in the most terrible time of the Inquisition", "disputed": false, "n_passes": 1}]</data>
