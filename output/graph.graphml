<edge source="Karamazov" target="Katerina Ivanovna" id="ENGAGED_TO">
  <data key="d6">ENGAGED_TO</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "A man of weak will, who had brought himself to take the three thousand so insultingly offered by his betrothed", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Karamazov" target="Katerina Ivanovna" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "A month before the catastrophe the prisoner was entrusted by Katerina Ivanovna with three thousand roubles to send off by post.", "disputed": true, "n_passes": 3}]</data>
</edge>
<edge source="Karamazov" target="Madame Svyetlov" id="LOVES">
  <data key="d6">LOVES</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "If she were to say to him, ‘I am yours, I won’t have Fyodor Pavlovitch,’ then he must have money to take her away.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Karamazov" target="Fyodor Pavlovitch Karamazov" id="RIVAL_OF">
  <data key="d6">RIVAL_OF</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "on the contrary, the latter heard that he meant to use this sum to seduce the woman he, the prisoner, loved.", "disputed": false, "n_passes": 2}]</data>
</edge>
<edge source="Karamazov" target="Fyodor Pavlovitch Karamazov" id="OWES_MONEY_TO">
  <data key="d6">OWES_MONEY_TO</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "as he expected to receive shortly from his father the three thousand roubles that he reckoned was owing to him.", "disputed": true, "n_passes": 1}]</data>
</edge>
<edge source="Karamazov" target="Fyodor Pavlovitch Karamazov" id="QUARRELS_WITH">
  <data key="d6">QUARRELS_WITH</data>
  <data key="d7">90</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch090", "global_index": 90, "label_ko": "12편 11장", "quote": "burst in himself and ended by beating the old man in the presence of witnesses.", "disputed": false, "n_passes": 1}]</data>
</edge>
<edge source="Karamazov" target="murder of Fyodor Pavlovitch" id="ACCUSED_OF">
  <data key="d6">ACCUSED_OF</data>
  <data key="d7">91</data>
  <data key="d8">1</data>
  <data key="d9">[{"doc_id": "ch091", "global_index": 91, "label_ko": "12편 12장", "quote": "What troubles me and makes me indignant is that of all the mass of facts heaped up by the prosecution against the prisoner, there is not a single one certain and irrefutable.", "disputed": false, "n_passes": 3}]</data>
</edge>
