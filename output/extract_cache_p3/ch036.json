    },
    {
      "subject": "Dmitri",
      "relation": "BROTHER_OF",
      "object": "Alyosha",
      "quote": "Several times afterwards he wondered how he could on leaving Ivan so completely forget his brother Dmitri",
      "disputed": false,
      "first_revealed_index": 36,
