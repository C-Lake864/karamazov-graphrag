    },
    {
      "subject": "Mitya",
      "relation": "BROTHER_OF",
      "object": "Alyosha",
      "quote": "Rakitin explained it all to me yesterday, brother, and it simply bowled me over.",
      "disputed": false,
      "first_revealed_index": 73,
      "doc_id": "ch073",
      "label_ko": "11편 4장"
    },
    {
      "subject": "Mitya",
      "relation": "LOVES",
      "object": "Alyosha",
