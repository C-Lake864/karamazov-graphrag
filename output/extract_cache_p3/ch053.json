    {
      "subject": "Mitya",
      "relation": "LOVES",
      "object": "Grushenka",
      "quote": "“I love you. I love only you. I’ll love you in Siberia....”",
      "disputed": false,
      "first_revealed_index": 53,
      "doc_id": "ch053",
