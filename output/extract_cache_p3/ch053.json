    },
    {
      "subject": "Grushenka",
      "relation": "LOVES",
      "object": "Dmitri Fyodorovitch",
      "quote": "She was ashamed, and from her eyes he could see now whom she loved.",
      "disputed": false,
      "first_revealed_index": 53,
      "doc_id": "ch053",
      "label_ko": "8편 8장"
    },
    {
      "subject": "Grushenka",
      "relation": "LOVES",
      "object": "Mitya",
      "quote": "Mitya, Mitya, how could I be such a fool as to think I could love any one after you? Do you forgive me, Mitya? Do you forgive me or not? Do you love me? Do you love me?",
      "disputed": false,
      "first_revealed_index": 53,
      "doc_id": "ch053",
      "label_ko": "8편 8장"
    },
    {
      "subject": "Mitya",
      "relation": "LOVES",
      "object": "Grushenka",
      "quote": "Mitya, dumb with rapture, gazed into her eyes, at her face, at her smile, and suddenly clasped her tightly in his arms and kissed her passionately.",
      "disputed": false,
      "first_revealed_index": 53,
      "doc_id": "ch053",
      "label_ko": "8편 8장"
    },
    {
      "subject": "Fyodor Pavlovitch Karamazov",
      "relation": "FATHER_OF",
      "object": "Mitya",
      "quote": "Ex-Lieutenant Karamazov, it is my duty to inform you that you are charged with the murder of your father, Fyodor Pavlovitch Karamazov, perpetrated this night....",
