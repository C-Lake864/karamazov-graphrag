  "triples": [
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "QUARRELS_WITH",
      "object": "Andrey",
      "quote": "“I was rude to him just now,” he repeated with a sinking, softened voice.",
      "disputed": false,
