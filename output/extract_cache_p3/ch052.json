    {
      "subject": "Dmitri Fyodorovitch Karamazov",
      "relation": "POSSESSES",
      "object": "bundle of notes",
      "quote": "Mitya had been, all this time, holding in his hand the crumpled bundle of notes on which the eyes of all, especially of the Poles, were fixed.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "QUARRELS_WITH",
      "object": "Pan Vrublevsky",
      "quote": "“You’re fools, you _panovie_,” broke suddenly from Mitya. “_Panie!_” shouted both the Poles, menacingly, setting on Mitya like a couple of cocks. Pan Vrublevsky was specially furious.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Grushenka",
      "relation": "QUARRELS_WITH",
      "object": "Mitya",
      "quote": "“Hold your tongue, you, anyway! Sit down, you stupid!” Grushenka scolded with angry annoyance.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "QUARRELS_WITH",
      "object": "Andrey",
      "quote": "“And vodka for Andrey, vodka for Andrey!” he cried in haste. “I was rude to Andrey!”",
      "disputed": false,
