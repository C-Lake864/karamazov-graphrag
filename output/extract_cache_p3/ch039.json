    {
      "subject": "Father Zossima",
      "relation": "MENTOR_OF",
      "object": "Alexey Fyodorovitch Karamazov",
      "quote": "“Father and teacher,” he began with extreme emotion, “your words are too obscure.... What is this suffering in store for him?”",
      "disputed": false,
      "first_revealed_index": 39,
      "doc_id": "ch039",
      "label_ko": "6편 1장"
    },
    {
      "subject": "Markel",
      "relation": "BROTHER_OF",
      "object": "Father Zossima",
      "quote": "There were two of us, my elder brother Markel and I. He was eight years older than I was, of hasty irritable temperament",
      "disputed": false,
      "first_revealed_index": 39,
      "doc_id": "ch039",
      "label_ko": "6편 1장"
    },
    {
      "subject": "Father Zossima",
