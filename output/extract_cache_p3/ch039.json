    {
      "subject": "Father Zossima",
      "relation": "LOVES",
      "object": "Alexey Fyodorovitch Karamazov",
      "quote": "Many times I’ve seen in your face as it were a look of mortification that I love Alexey more than you.",
      "disputed": false,
      "first_revealed_index": 39,
      "doc_id": "ch039",
      "label_ko": "6편 1장"
    },
    {
      "subject": "Father Zossima",
      "relation": "LOVES",
      "object": "Porfiry",
      "quote": "Now you know why that was so, but I love you too, know that, and many times I grieved at your mortification.",
      "disputed": false,
      "first_revealed_index": 39,
      "doc_id": "ch039",
      "label_ko": "6편 1장"
    },
    {
      "subject": "Father Zossima",
      "relation": "LOVES",
      "object": "Father Anfim",
      "quote": "Father Zossima had a great affection for this timorous man, and always treated him with marked respect",
      "disputed": false,
