    {
      "subject": "Dmitri",
      "relation": "BROTHER_OF",
      "object": "Alexey",
      "quote": "He remembered afterwards how, on that terrible day, he had entirely forgotten his brother Dmitri, about whom he had been so anxious and troubled the day before",
      "disputed": false,
      "first_revealed_index": 43,
      "doc_id": "ch043",
      "label_ko": "7편 2장"
    },
    {
      "subject": "Ivan",
      "relation": "BROTHER_OF",
      "object": "Alexey",
      "quote": "If your little brother Ivan could see this—wouldn’t he be surprised! By the way, your brother Ivan set off to Moscow this morning, did you know?",
