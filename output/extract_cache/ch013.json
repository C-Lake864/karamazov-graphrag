  "triples": [
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Ivan Fyodorovitch",
      "quote": "and begged me, and his son Ivan Fyodorovitch, to convey to you his apologies and regrets.",
      "disputed": false,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Alexey",
      "quote": "My son, Alexey, is here, being saved. I am his father; I care for his welfare, and it is my duty to care.",
      "disputed": false,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Pyotr Alexandrovitch Miüsov",
      "relation": "QUARRELS_WITH",
      "object": "Fyodor Pavlovitch",
      "quote": "He felt that he ought to have disdained that despicable wretch, Fyodor Pavlovitch, too much to have been upset by him in Father Zossima’s cell, and so to have forgotten himself.",
      "disputed": false,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Pyotr Alexandrovitch Miüsov",
      "relation": "RELATED_TO",
      "object": "Fyodor Pavlovitch",
      "quote": "You stung him by what you said about family harmony, Father Superior, he does not admit he is my relation.",
      "disputed": true,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Alexey",
      "quote": "and I shall take my son, Alexey, home.",
      "disputed": false,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Ivan Fyodorovitch",
      "quote": "Ivan Fyodorovitch, my most dutiful son, permit me to order you to follow me.",
      "disputed": false,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "QUARRELS_WITH",
      "object": "Father Superior",
      "quote": "Holy Father, I am indignant with you.",
      "disputed": false,
      "first_revealed_index": 13,
      "doc_id": "ch013",
      "label_ko": "2편 8장"
    },
    {
      "subject": "Ivan Fyodorovitch",
      "relation": "QUARRELS_WITH",
      "object": "Maximov",
      "quote": "Ivan, who had by now taken his seat, without a word gave Maximov a violent punch in the breast and sent him flying.",
