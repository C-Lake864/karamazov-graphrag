    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Mitya",
      "quote": "But you are your father’s son, too, you know; yet you yourself told every one you meant to murder him.",
      "disputed": false,
      "first_revealed_index": 58,
      "doc_id": "ch058",
      "label_ko": "9편 5장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Smerdyakov",
      "quote": "Why, he’s very likely his son, you know—his natural son. Do you know that?” “We have heard that legend.",
      "disputed": true,
      "first_revealed_index": 58,
      "doc_id": "ch058",
      "label_ko": "9편 5장"
    },
    {
      "subject": "Smerdyakov",
      "relation": "SERVANT_OF",
      "object": "Fyodor Pavlovitch",
      "quote": "So no one knew of the signals but your dead father, you, and the valet Smerdyakov?",
