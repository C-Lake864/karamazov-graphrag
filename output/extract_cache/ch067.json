      "label_ko": "10편 5장"
    },
    {
      "subject": "Ilusha",
      "relation": "QUARRELS_WITH",
      "object": "Kolya Krassotkin",
      "quote": "Perhaps the bitterest of all his bitter memories was his stabbing Krassotkin, who had been his one friend and protector.",
      "disputed": false,
      "first_revealed_index": 67,
      "doc_id": "ch067",
      "label_ko": "10편 5장"
    },
    {
      "subject": "Ilusha",
      "relation": "QUARRELS_WITH",
