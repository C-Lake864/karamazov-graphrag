    {
      "subject": "Ilusha",
      "relation": "LOVES",
      "object": "Madame Snegiryov",
      "quote": "Ilusha, darling, he’s the one who loves his mamma!",
      "disputed": false,
      "first_revealed_index": 67,
      "doc_id": "ch067",
      "label_ko": "10편 5장"
    },
    {
      "subject": "Dardanelov",
      "relation": "MENTOR_OF",
      "object": "Kolya",
      "quote": "I say nothing against Dardanelov, he is a learned man, there’s no doubt about it. I respect men like that and it’s not because he stood up for me.",
      "disputed": false,
      "first_revealed_index": 67,
      "doc_id": "ch067",
      "label_ko": "10편 5장"
    },
    {
      "subject": "Kolbasnikov",
      "relation": "MENTOR_OF",
      "object": "Kolya",
      "quote": "The classical master, Kolbasnikov, was particularly shocked about it, but Dardanelov got me off again.",
      "disputed": false,
      "first_revealed_index": 67,
      "doc_id": "ch067",
      "label_ko": "10편 5장"
    },
    {
      "subject": "Kolbasnikov",
      "relation": "MENTOR_OF",
      "object": "Kolya",
      "quote": "Besides, what I said just now about the classics being translated our teacher Kolbasnikov has said to the whole of the third class.",
      "disputed": false,
      "first_revealed_index": 67,
      "doc_id": "ch067",
      "label_ko": "10편 5장"
    },
    {
      "subject": "Mr. Snegiryov",
      "relation": "FATHER_OF",
      "object": "Ilusha",
      "quote": "“Yes, father, he says that and yet he is first in Latin,” echoed Ilusha.",
