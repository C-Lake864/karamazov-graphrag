      "label_ko": "5편 6장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Ivan Fyodorovitch",
      "quote": "Dmitri won’t come to steal money and kill my father to do it.",
      "disputed": false,
      "first_revealed_index": 37,
