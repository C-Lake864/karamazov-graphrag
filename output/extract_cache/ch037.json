    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "POSSESSES",
      "object": "envelope with three thousand roubles",
      "quote": "He is perfectly well aware, too, that Fyodor Pavlovitch has a big envelope with three thousand roubles in it, tied up with ribbon and sealed with three seals.",
      "disputed": false,
      "first_revealed_index": 37,
      "doc_id": "ch037",
      "label_ko": "5편 6장"
    },
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "QUARRELS_WITH",
      "object": "Smerdyakov",
      "quote": "Dmitri Fyodorovitch kept persisting every day, ‘You are deceiving me, you are hiding something from me! I’ll break both your legs for you.’",
      "disputed": false,
      "first_revealed_index": 37,
      "doc_id": "ch037",
      "label_ko": "5편 6장"
    },
    {
      "subject": "Ivan Fyodorovitch",
      "relation": "QUARRELS_WITH",
      "object": "Smerdyakov",
      "quote": "“You seem to be a perfect idiot, and what’s more ... an awful scoundrel, too.” Ivan rose suddenly from the bench.",
