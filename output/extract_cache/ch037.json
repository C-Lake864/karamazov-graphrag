    {
      "subject": "Ivan Fyodorovitch",
      "relation": "QUARRELS_WITH",
      "object": "Smerdyakov",
      "quote": "“Damn you! Speak out what you want!” Ivan cried angrily at last, passing from meekness to violence.",
      "disputed": false,
      "first_revealed_index": 37,
      "doc_id": "ch037",
      "label_ko": "5편 6장"
    },
    {
      "subject": "Ivan Fyodorovitch",
      "relation": "BROTHER_OF",
      "object": "Dmitri Fyodorovitch",
      "quote": "All my brother Dmitri’s threats are only hasty words and mean nothing.",
      "disputed": false,
      "first_revealed_index": 37,
      "doc_id": "ch037",
      "label_ko": "5편 6장"
    },
    {
      "subject": "Ivan Fyodorovitch",
      "relation": "BROTHER_OF",
      "object": "Alexey Fyodorovitch",
      "quote": "neither Dmitri Fyodorovitch nor yourself and your brother, Alexey Fyodorovitch, would have anything after the master’s death",
      "disputed": false,
