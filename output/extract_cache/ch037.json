      "label_ko": "5편 6장"
    },
    {
      "subject": "Smerdyakov",
      "relation": "SERVANT_OF",
      "object": "Fyodor Pavlovitch",
      "quote": "But Grigory Vassilyevitch does not come, because I wait upon him alone in his room now.",
      "disputed": false,
      "first_revealed_index": 37,
      "doc_id": "ch037",
      "label_ko": "5편 6장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "OWES_MONEY_TO",
      "object": "Dmitri Fyodorovitch",
      "quote": "‘My father still owes me just three thousand,’ he said.",
      "disputed": true,
      "first_revealed_index": 37,
