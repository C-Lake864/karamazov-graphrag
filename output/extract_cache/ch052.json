    },
    {
      "subject": "Vrublevsky",
      "relation": "QUARRELS_WITH",
      "object": "Grushenka",
      "quote": "Vrublevsky, with a confused and infuriated face, shook his fist at Grushenka, shouting: “You low harlot!”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
