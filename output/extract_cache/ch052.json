  "triples": [
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "LOVES",
      "object": "Grushenka",
      "quote": "I wanted to spend my last day, my last hour in this room, in this very room ... where I, too, adored ... my queen....",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "POSSESSES",
      "object": "bundle of notes",
      "quote": "Mitya had been, all this time, holding in his hand the crumpled bundle of notes on which the eyes of all, especially of the Poles, were fixed.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "QUARRELS_WITH",
      "object": "Pan Vrublevsky",
      "quote": "“You’re fools, you _panovie_,” broke suddenly from Mitya. “_Panie!_” shouted both the Poles, menacingly, setting on Mitya like a couple of cocks.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Grushenka",
      "relation": "QUARRELS_WITH",
      "object": "Mitya",
      "quote": "“Hold your tongue, you, anyway! Sit down, you stupid!” Grushenka scolded with angry annoyance.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "QUARRELS_WITH",
      "object": "Andrey",
      "quote": "“And vodka for Andrey, vodka for Andrey!” he cried in haste. “I was rude to Andrey!”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "POSSESSES",
      "object": "two hundred-rouble notes",
      "quote": "“Begin, _panie_,” Mitya assented, pulling his notes out of his pocket, and laying two hundred-rouble notes on the table.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "QUARRELS_WITH",
      "object": "Andrey",
      "quote": "“And vodka for Andrey, vodka for Andrey!” he cried in haste. “I was rude to Andrey!”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Pan Vrublevsky",
      "relation": "QUARRELS_WITH",
      "object": "Kalganov",
      "quote": "“How dare you!” Pan Vrublevsky, too, growled at Kalganov.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Grushenka",
      "relation": "QUARRELS_WITH",
      "object": "Pan Vrublevsky",
      "quote": "“Don’t dare to shout like that,” cried Grushenka. “Ah, you turkey-cocks!”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Grushenka",
      "relation": "QUARRELS_WITH",
      "object": "Mitya",
      "quote": "“What? He offered you money for me?” cried Grushenka, hysterically. “Is it true, Mitya? How dare you? Am I for sale?”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Grushenka",
      "relation": "QUARRELS_WITH",
      "object": "Kuzma",
      "quote": "it wasn’t virtue kept me pure, and it wasn’t that I was afraid of Kuzma, but that I might hold up my head when I met him, and tell him he’s a scoundrel.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Podvysotsky",
      "relation": "PRESENT_AT",
      "object": "Warsaw",
      "quote": "In Warsaw there was a bank and any one comes and stakes against it. Podvysotsky comes, sees a thousand gold pieces, stakes against the bank.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "POSSESSES",
      "object": "3000 roubles",
      "quote": "Besides, I haven’t the three thousand with me. I’ve got it at home in the town,” faltered Mitya, his spirit sinking at every word he uttered. “Upon my word, the money’s there, hidden.”",
      "disputed": true,
      "first_revealed_index": 52,
      "doc_id": "ch052",
