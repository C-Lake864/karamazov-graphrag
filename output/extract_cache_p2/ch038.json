      "first_revealed_index": 38,
      "doc_id": "ch038",
      "label_ko": "5편 7장"
    },
    {
      "subject": "Fyodor Pavlovitch Karamazov",
      "relation": "PRESENT_AT",
      "object": "Smerdyakov's epileptic fit",
      "quote": "Fyodor Pavlovitch himself was present at the whole ceremony. He helped, evidently alarmed and upset.",
      "disputed": false,
      "first_revealed_index": 38,
      "doc_id": "ch038",
      "label_ko": "5편 7장"
    },
    {
      "subject": "Marfa Ignatyevna",
      "relation": "PRESENT_AT",
      "object": "Smerdyakov's epileptic fit",
      "quote": "Fortunately, Marfa Ignatyevna was in the yard and heard him in time. She did not see the fall, but heard his scream",
