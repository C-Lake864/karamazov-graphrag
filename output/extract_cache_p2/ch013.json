    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Alexey",
      "quote": "at the first opportunity I shall write to the Synod, and I shall take my son, Alexey, home.",
      "disputed": false,
      "first_revealed_index": 13,
