      "label_ko": "2편 8장"
    },
    {
      "subject": "Fyodor Pavlovitch",
      "relation": "FATHER_OF",
      "object": "Ivan Fyodorovitch",
      "quote": "Ivan Fyodorovitch, my most dutiful son, permit me to order you to follow me.",
      "disputed": false,
      "first_revealed_index": 13,
