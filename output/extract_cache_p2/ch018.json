    {
      "subject": "Dmitri Karamazov",
      "relation": "ENGAGED_TO",
      "object": "Katerina Ivanovna",
      "quote": "Yes, formally and solemnly betrothed. It was all done on my arrival in Moscow, with great ceremony, with ikons, all in fine style.",
      "disputed": false,
      "first_revealed_index": 18,
      "doc_id": "ch018",
      "label_ko": "3편 5장"
    },
    {
      "subject": "Katerina Ivanovna",
      "relation": "LOVES",
      "object": "Dmitri Karamazov",
      "quote": "‘I love you madly,’ she says, ‘even if you don’t love me, never mind. Be my husband. Don’t be afraid. I won’t hamper you in any way.",
      "disputed": true,
      "first_revealed_index": 18,
      "doc_id": "ch018",
      "label_ko": "3편 5장"
    },
    {
      "subject": "Ivan",
      "relation": "LOVES",
      "object": "Katerina Ivanovna",
      "quote": "Yes, Ivan fell in love with her; he’s in love with her still. I know that.",
      "disputed": true,
      "first_revealed_index": 18,
      "doc_id": "ch018",
      "label_ko": "3편 5장"
    },
    {
