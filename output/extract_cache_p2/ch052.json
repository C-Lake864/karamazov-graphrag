  "triples": [
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "LOVES",
      "object": "Grushenka",
      "quote": "I wanted to spend my last day, my last hour in this room, in this very room ... where I, too, adored ... my queen....",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "POSSESSES",
      "object": "bundle of notes",
      "quote": "Mitya had been, all this time, holding in his hand the crumpled bundle of notes on which the eyes of all, especially of the Poles, were fixed.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "LIVES_AT",
      "object": "the inn",
      "quote": "I ... I’m coming, too. I’m here till morning. Gentlemen, may I stay with you till morning? Only till morning, for the last time, in this same room?",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Kalganov",
      "relation": "LIVES_AT",
      "object": "the inn",
      "quote": "He had come here with Maximov by chance, and he met the Poles here at the inn for the first time in his life.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Grushenka",
      "relation": "QUARRELS_WITH",
      "object": "Mitya",
      "quote": "“Hold your tongue, you, anyway! Sit down, you stupid!” Grushenka scolded with angry annoyance.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Mitya",
      "relation": "QUARRELS_WITH",
      "object": "Andrey",
      "quote": "“And vodka for Andrey, vodka for Andrey!” he cried in haste. “I was rude to Andrey!”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Pan Vrublevsky",
      "relation": "QUARRELS_WITH",
      "object": "Kalganov",
      "quote": "“How dare you!” Pan Vrublevsky, too, growled at Kalganov.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Agrafena",
      "relation": "QUARRELS_WITH",
      "object": "Mitya",
      "quote": "“How dare you defend me to him?” shrieked Grushenka.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Agrafena",
      "relation": "QUARRELS_WITH",
      "object": "Pan Vrublevsky",
      "quote": "“Don’t dare to shout like that,” cried Grushenka.",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Pan Vrublevsky",
      "relation": "QUARRELS_WITH",
      "object": "Grushenka",
      "quote": "Vrublevsky, with a confused and infuriated face, shook his fist at Grushenka, shouting: “You low harlot!”",
      "disputed": false,
      "first_revealed_index": 52,
      "doc_id": "ch052",
      "label_ko": "8편 7장"
    },
    {
      "subject": "Dmitri Fyodorovitch",
      "relation": "QUARRELS_WITH",
      "object": "Pan Vrublevsky",
      "quote": "Mitya flew at him at once, clutched him in both hands, lifted him in the air, and in one instant had carried him into the room on the right",
