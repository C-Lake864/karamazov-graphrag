    },
    {
      "subject": "Lise",
      "relation": "QUARRELS_WITH",
      "object": "Alexey Fyodorovitch",
      "quote": "here I’ve brought you Alexey Fyodorovitch, whom you insulted so. He is not at all angry, I assure you; on the contrary, he is surprised that you could suppose so.",
      "disputed": true,
      "first_revealed_index": 32,
      "doc_id": "ch032",
      "label_ko": "5편 1장"
    },
    {
      "subject": "Ivan",
      "relation": "BROTHER_OF",
      "object": "Alexey Fyodorovitch",
      "quote": "“I don’t like your brother Ivan, Alyosha,” said Lise suddenly.",
      "disputed": false,
      "first_revealed_index": 32,
      "doc_id": "ch032",
      "label_ko": "5편 1장"
    },
    {
      "subject": "Lise",
      "relation": "LOVES",
      "object": "Alexey Fyodorovitch",
      "quote": "Alyosha, I am awfully fond of you. Just before you came this morning, I tried my fortune.",
      "disputed": false,
      "first_revealed_index": 32,
      "doc_id": "ch032",
      "label_ko": "5편 1장"
    },
    {
      "subject": "Alexey Fyodorovitch",
      "relation": "ENGAGED_TO",
      "object": "Lise",
      "quote": "He has chosen me as his wife and is quite settled about it. He is sure I was in earnest.",
      "disputed": false,
      "first_revealed_index": 32,
      "doc_id": "ch032",
      "label_ko": "5편 1장"
    },
    {
      "subject": "Alexey Fyodorovitch",
      "relation": "POSSESSES",
      "object": "Lise's letter",
      "quote": "The letter is with me now, and it was this morning, in this pocket. Here it is.” Alyosha pulled the letter out laughing, and showed it her at a distance.",
