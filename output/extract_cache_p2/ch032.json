      "first_revealed_index": 32,
      "doc_id": "ch032",
      "label_ko": "5편 1장"
    },
    {
      "subject": "Madame Hohlakov",
      "relation": "QUARRELS_WITH",
      "object": "Alexey Fyodorovitch",
      "quote": "“Alexey Fyodorovitch, this is awful. This is all childish nonsense and ridiculous. I trust you won’t dream—It’s foolishness, nothing but foolishness!” she said, attacking him at once.",
