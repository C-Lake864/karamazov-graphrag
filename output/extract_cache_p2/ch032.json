    {
      "subject": "Father Zossima",
      "relation": "MENTOR_OF",
      "object": "Alexey Fyodorovitch",
      "quote": "Do you know, Lise, my elder told me once to care for most people exactly as one would for children, and for some of them as one would for the sick in hospitals.",
      "disputed": false,
      "first_revealed_index": 32,
      "doc_id": "ch032",
